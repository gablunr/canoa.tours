---
import { durationCategories, durationCategoryLabels, durationCategorySlugs, tourCountText, tourDetails } from '../../../data/tours/tours';

const options = [
	{ value: 'todas', label: 'Todas' },
	...durationCategories.map((category) => ({ value: durationCategorySlugs[category], label: durationCategoryLabels[category] })),
];
---

<div class="mt-6 flex flex-col items-center gap-4">
	<fieldset data-catalog-filter class="flex max-w-full justify-center gap-1 sm:flex-wrap sm:gap-2">
		<legend class="sr-only">Filtrar por duración</legend>
		{options.map((option) => (
			<label class="liquid-glass inline-flex h-9 shrink-0 cursor-pointer items-center px-2.5 text-[13px] whitespace-nowrap font-medium text-white bg-primary/30 backdrop-blur-md transition-colors duration-300 ease-smooth hover:bg-primary/45 has-checked:bg-white has-checked:text-primary has-focus-visible:ring-2 has-focus-visible:ring-white has-focus-visible:ring-offset-2 has-focus-visible:ring-offset-primary sm:px-4">
				<input type="radio" name="duracion" value={option.value} checked={option.value === 'todas'} class="sr-only" />
				{option.label}
			</label>
		))}
	</fieldset>
	<p data-catalog-count aria-live="polite" class="text-xs text-white/80 drop-shadow-md">{tourCountText(tourDetails.length)}</p>
</div>
