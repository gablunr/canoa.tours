---
import TourCard from '../../ui/cards/TourCard.astro';
import UnderlineLink from '../../ui/UnderlineLink.astro';
import type { CatalogGroup } from '../../../data/tours/catalog';
import { destinationHref, tourCountLabel } from '../../../data/tours/destinations';
import {
	destinationToursTitle,
	durationCategoryLabels,
	durationCategorySlugs,
	scheduleLabel,
	tourDeparture,
	tourDetailsHref,
	tourPhoto,
	tourPhotoAlt,
} from '../../../data/tours/tours';
import { formatPrice } from '../../../lib/format';

interface Props {
	group: CatalogGroup;
}

const { destination, anchor, intro, tours } = Astro.props.group;
const titleId = `${anchor}-title`;
const pillarLabel = `Todo sobre ${destination.kind === 'place' ? destination.name : destinationToursTitle(destination).toLowerCase()}`;
---

<section id={anchor} aria-labelledby={titleId} data-catalog-group={anchor} class="mt-12 scroll-mt-24 lg:mt-16">
	<div
		data-reveal
		class="flex flex-col gap-3 border-t border-border/60 pt-8 max-lg:items-center max-lg:text-center lg:flex-row lg:items-end lg:justify-between lg:gap-16"
	>
		<div>
			<p class="text-sm text-muted">{tourCountLabel(destination)}, desde {formatPrice(destination.fromPrice)}</p>
			<h2 id={titleId} class="mt-1 text-3xl leading-[1.1] font-semibold tracking-[-0.03em] text-primary md:text-4xl">
				{destinationToursTitle(destination)}
			</h2>
			<p class="mt-3 max-w-xl text-[15px] leading-relaxed text-pretty text-secondary">{intro}</p>
		</div>
		<UnderlineLink href={destinationHref(destination)} tone="accent" class="shrink-0">{pillarLabel}</UnderlineLink>
	</div>

	<ul class="-mx-4 mt-8 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 pb-4 [scrollbar-width:none] sm:-mx-6 sm:scroll-px-6 sm:px-6 md:-mx-12 md:scroll-px-12 md:px-12 lg:mx-0 lg:grid lg:snap-none lg:grid-cols-4 lg:gap-5 lg:overflow-visible lg:px-0 lg:pb-0 [&::-webkit-scrollbar]:hidden">
		{tours.map((details) => (
			<li data-reveal data-duration={durationCategorySlugs[details.durationCategory]} class="w-[78%] max-w-xs shrink-0 snap-start sm:w-[42%] md:w-[38%] lg:w-auto lg:max-w-none">
				<TourCard
					href={tourDetailsHref(details)}
					title={details.title}
					badge={durationCategoryLabels[details.durationCategory]}
					price={formatPrice(details.price)}
					priceUnit={details.priceUnit}
					schedule={scheduleLabel(details.days)}
					departure={tourDeparture(details)}
					image={tourPhoto(details)}
					imageAlt={tourPhotoAlt(details)}
					glowClass="max-lg:hidden"
				/>
			</li>
		))}
	</ul>
</section>
