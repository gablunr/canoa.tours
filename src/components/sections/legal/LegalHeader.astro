---
import { formatUpdatedDate, readingMinutes, updatedIsoDate, type LegalDocument } from '../../../data/legal';

interface Props {
	legalDocument: LegalDocument;
}

const { legalDocument } = Astro.props;
const { title, description } = legalDocument.data;
---

<header class="px-4 pt-16 sm:px-6 md:pt-24">
	<div class="mx-auto max-w-6xl">
		<div class="mx-auto max-w-3xl text-center md:mx-0 md:text-left">
			<h1
				class="animate-fade-up text-4xl leading-[1.05] font-medium tracking-tight text-balance md:text-5xl"
				style="animation-delay: 60ms"
			>
				{title}
			</h1>
			<p class="mt-5 animate-fade-up text-lg leading-relaxed text-muted" style="animation-delay: 120ms">
				{description}
			</p>
		</div>

		<dl
			class="mt-10 flex animate-fade-up flex-wrap justify-center gap-x-12 gap-y-4 border-t border-border/60 pt-6 text-sm md:justify-start"
			style="animation-delay: 180ms"
		>
			<div>
				<dt class="text-muted">Última actualización</dt>
				<dd class="mt-1 font-medium text-primary">
					<time datetime={updatedIsoDate(legalDocument)}>{formatUpdatedDate(legalDocument)}</time>
				</dd>
			</div>
			<div>
				<dt class="text-muted">Lectura</dt>
				<dd class="mt-1 font-medium text-primary">{readingMinutes(legalDocument)} min</dd>
			</div>
		</dl>
	</div>
</header>
