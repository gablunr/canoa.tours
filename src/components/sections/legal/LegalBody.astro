---
import { render } from 'astro:content';
import { company } from '../../../data/company';
import { legalHref, type LegalDocument } from '../../../data/legal';
import { legalLinks } from '../../../data/navigation';
import UnderlineLink from '../../ui/UnderlineLink.astro';

interface Props {
	legalDocument: LegalDocument;
}

const { legalDocument } = Astro.props;
const { summary } = legalDocument.data;
const { Content, headings } = await render(legalDocument);

const sections = headings.filter((heading) => heading.depth === 2);
const otherDocuments = legalLinks.filter((link) => link.href !== legalHref(legalDocument));
const sectionNumber = (index: number) => String(index + 1).padStart(2, '0');
---

<div class="px-4 pt-12 pb-24 sm:px-6 md:pt-16 md:pb-32">
	<div data-reveal class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[15rem_minmax(0,48rem)] lg:justify-center lg:gap-20">
		<aside class="mx-auto w-full max-w-3xl lg:sticky lg:top-36 lg:mx-0 lg:self-start">
			<nav
				aria-labelledby="legal-contents-title"
				class="rounded-3xl border border-border/50 bg-surface/60 p-6 lg:rounded-none lg:border-0 lg:bg-transparent lg:p-0"
			>
				<p id="legal-contents-title" class="text-sm font-medium text-primary">En esta página</p>
				<ol class="relative mt-4 border-l border-border/60 text-sm">
					<span
						data-toc-indicator
						class="absolute top-0 -left-px w-px bg-accent-strong opacity-0 transition-[translate,height,opacity] duration-500 ease-smooth"
						aria-hidden="true"
					></span>
					{sections.map((section, index) => (
						<li>
							<a
								href={`#${section.slug}`}
								data-toc-link
								class="group/toc flex gap-3 py-1.5 pl-4 leading-snug text-muted transition-colors duration-300 ease-smooth hover:text-primary aria-[current=true]:text-primary"
							>
								<span class="w-5 shrink-0 text-xs leading-5 text-subtle tabular-nums transition-colors duration-300 ease-smooth group-aria-[current=true]/toc:text-accent-strong">
									{sectionNumber(index)}
								</span>
								<span class="transition-transform duration-500 ease-smooth group-hover/toc:translate-x-1">{section.text}</span>
							</a>
						</li>
					))}
				</ol>
			</nav>

			{otherDocuments.length > 0 && (
				<div class="mt-10 hidden lg:block">
					<p class="text-sm font-medium text-primary">Otros documentos</p>
					<ul class="mt-3 grid justify-items-start gap-2">
						{otherDocuments.map((link) => (
							<li>
								<UnderlineLink href={link.href}>{link.label}</UnderlineLink>
							</li>
						))}
					</ul>
				</div>
			)}
		</aside>

		<div class="mx-auto w-full max-w-3xl lg:mx-0">
			{summary && (
				<div class="mb-14 rounded-3xl bg-surface p-6 sm:p-8">
					<p class="text-sm font-medium text-accent-strong">Lo esencial</p>
					<p class="mt-3 text-lg leading-relaxed text-primary">{summary}</p>
				</div>
			)}

			<div class="legal-content">
				<Content />
			</div>

			<div class="mt-16 flex flex-col gap-6 rounded-3xl border border-border/50 p-6 transition-colors duration-500 ease-smooth hover:border-border sm:p-8 md:flex-row md:items-center md:justify-between">
				<div>
					<h2 class="text-lg font-medium tracking-tight text-primary">¿Tienes dudas sobre este documento?</h2>
					<p class="mt-1 text-sm leading-relaxed text-muted">Escríbenos y te respondemos lo antes posible.</p>
				</div>
				<div class="flex shrink-0 flex-wrap gap-x-6 gap-y-3">
					<UnderlineLink tone="accent" href={`mailto:${company.email}`}>{company.email}</UnderlineLink>
					{company.phone && <UnderlineLink tone="accent" href={company.phone.href}>{company.phone.label}</UnderlineLink>}
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	.legal-content {
		counter-reset: legal-section;
		font-size: 1rem;
		line-height: 1.8;
		color: var(--color-secondary);
		overflow-wrap: break-word;
	}

	.legal-content > :global(* + *) {
		margin-top: 1.1em;
	}

	.legal-content :global(h2) {
		counter-increment: legal-section;
		display: flex;
		align-items: baseline;
		gap: 1rem;
		margin-top: 3.5rem;
		border-top: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
		padding-top: 3.5rem;
		font-family: var(--font-display);
		font-size: 1.625rem;
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: var(--color-primary);
		text-wrap: balance;
		scroll-margin-top: 8rem;
	}

	.legal-content :global(h2::before) {
		content: counter(legal-section, decimal-leading-zero);
		flex-shrink: 0;
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0;
		color: var(--color-accent-strong);
		font-variant-numeric: tabular-nums;
	}

	.legal-content :global(h2:target) {
		animation: section-arrival 2s var(--ease-smooth);
	}

	@keyframes section-arrival {
		0%,
		40% {
			color: var(--color-accent-strong);
		}
		100% {
			color: var(--color-primary);
		}
	}

	.legal-content > :global(h2:first-child) {
		margin-top: 0;
		border-top: 0;
		padding-top: 0;
	}

	.legal-content :global(h3) {
		margin-top: 2em;
		font-family: var(--font-display);
		font-size: 1.125rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--color-primary);
	}

	.legal-content :global(:is(h2, h3) + *) {
		margin-top: 1em;
	}

	.legal-content :global(h2 + h3) {
		margin-top: 1.5em;
	}

	.legal-content :global(a) {
		color: var(--color-accent-strong);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-decoration-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
		text-underline-offset: 0.2em;
		transition: text-decoration-color 0.3s var(--ease-smooth);
	}

	.legal-content :global(a:hover) {
		text-decoration-color: var(--color-accent-strong);
	}

	.legal-content :global(strong) {
		font-weight: 500;
		color: var(--color-primary);
	}

	.legal-content :global(:is(ul, ol)) {
		padding-left: 1.25em;
	}

	.legal-content :global(ul) {
		list-style: disc;
	}

	.legal-content :global(ol) {
		list-style: decimal;
	}

	.legal-content :global(li + li) {
		margin-top: 0.6em;
	}

	.legal-content :global(li::marker) {
		color: var(--color-accent);
	}
</style>

<script>
	import { initTableOfContents } from '../../../scripts/table-of-contents';

	const root = document.querySelector<HTMLElement>('[data-legal-document]');
	if (root) initTableOfContents(root);
</script>
