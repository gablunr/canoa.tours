---
import { Picture } from 'astro:assets';
import type { HTMLAttributes } from 'astro/types';
import { imageSource, type SiteImage } from '../../../lib/images';

interface Props extends Omit<HTMLAttributes<'section'>, 'title' | 'class'> {
	title: string;
	image: SiteImage;
	imageAlt: string;
	imageClass?: string;
	sizes?: string;
	compact?: boolean;
	introClass?: string;
	dim?: boolean;
}

const { title, image, imageAlt, imageClass = 'object-center', sizes, compact = false, introClass = 'max-w-2xl', dim = false, ...attributes } =
	Astro.props;

const coverSizes = sizes ?? `(max-aspect-ratio: ${image.width}/${image.height}) ${Math.ceil((image.width / image.height) * 100)}vh, 100vw`;
const widths = [...new Set([640, 960, 1280, 1920, 2560].map((width) => Math.min(width, image.width)))];
---

<section
	{...attributes}
	class:list={[
		'relative isolate -mt-14 flex flex-col justify-center overflow-hidden bg-primary',
		compact
			? '[--hero-space:calc(3.125rem+max(6vw,10svh))] md:[--hero-space:calc(3.625rem+max(6vw,10svh))]'
			: 'min-h-[max(36rem,70svh)] [--hero-space:calc(3.125rem+max(8vw,13svh))] md:[--hero-space:calc(3.625rem+max(8vw,13svh))]',
	]}
>
	<Picture
		{...imageSource(image)}
		alt={imageAlt}
		formats={['avif', 'webp']}
		widths={widths}
		sizes={coverSizes}
		priority
		pictureAttributes={{ class: 'absolute inset-0 -z-20' }}
		class:list={['size-full object-cover brightness-85 saturate-110 contrast-105', imageClass]}
	/>
	<div class="film-grain absolute inset-0 -z-20 opacity-90" aria-hidden="true"></div>
	{dim && <div class="absolute inset-0 -z-10 bg-primary/40" aria-hidden="true"></div>}
	<div
		class="absolute inset-0 -z-10 bg-linear-to-b from-primary/70 via-primary/25 via-35% to-transparent to-60%"
		aria-hidden="true"
	></div>
	<div
		class="absolute inset-x-0 bottom-0 -z-10 h-16 bg-linear-to-t from-background via-background/60 to-transparent"
		aria-hidden="true"
	></div>

	<div
		class:list={[
			'mx-auto flex w-full max-w-4xl min-w-0 flex-col items-center px-4 pt-(--hero-space) text-center text-white sm:px-6',
			compact ? 'pb-[calc(1rem+var(--hero-space))]' : 'pb-[calc(3.5rem+var(--hero-space))]',
		]}
	>
		<slot name="badge" />
		<h1
			class="mt-5 animate-fade-up text-5xl leading-[0.98] font-semibold tracking-[-0.04em] text-balance sm:text-6xl lg:text-7xl"
			style="animation-delay: 630ms"
		>
			<span class="bg-linear-to-b from-white from-30% to-ink-200 bg-clip-text text-transparent drop-shadow-md">
				{title}
			</span>
		</h1>
		<p
			class:list={['mt-8 animate-fade-up font-display text-base leading-[1.4] tracking-[-0.01em] text-balance sm:text-lg md:text-xl', introClass]}
			style="animation-delay: 710ms"
		>
			<slot />
		</p>
		<slot name="actions" />
	</div>
</section>
