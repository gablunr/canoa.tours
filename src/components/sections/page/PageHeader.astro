---
interface Props {
	title: string;
	intro: string;
	centered?: boolean;
}

const { title, intro, centered = false } = Astro.props;
---

<header class="px-4 pt-16 sm:px-6 md:px-12 md:pt-24 lg:px-6">
	<div class:list={['mx-auto max-w-6xl', centered ? 'text-center' : 'max-lg:text-center']}>
		<h1
			class="animate-fade-up bg-linear-to-b from-primary to-muted bg-clip-text text-5xl leading-[0.98] font-semibold tracking-[-0.04em] text-transparent sm:text-6xl lg:text-7xl"
			style="animation-delay: 60ms"
		>
			{title}
		</h1>
		<p
			class:list={[
				'mt-8 max-w-2xl animate-fade-up font-display text-lg leading-[1.45] tracking-[-0.01em] text-secondary md:text-xl',
				centered ? 'mx-auto text-balance' : 'text-pretty max-lg:mx-auto max-lg:text-balance',
			]}
			style="animation-delay: 120ms"
		>
			{intro}
		</p>
	</div>
</header>
