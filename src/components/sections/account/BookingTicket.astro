---
import type { BookingDetails } from '../../../lib/booking/booking-details';

interface Props {
	details: BookingDetails;
}

const { details } = Astro.props;
const isActive = details.status === 'confirmed';
---

<section aria-labelledby="codigo-reserva" class="relative isolate overflow-hidden rounded-[2rem] bg-primary p-6 text-white sm:p-8">
	<h2 id="codigo-reserva" class="text-sm text-muted-on-dark">Código de reserva</h2>
	<p class="mt-2 font-display text-4xl font-semibold tracking-[0.12em]">{details.code}</p>
	<p class="mt-3 text-sm leading-relaxed text-muted-on-dark">
		{isActive ? 'Enséñalo al guía cuando te recojan en el hotel.' : 'Guárdalo si necesitas escribirnos por esta reserva.'}
	</p>
	<dl class="mt-6 flex justify-between gap-4 border-t border-white/10 pt-4 text-sm">
		<dt class="text-muted-on-dark">A nombre de</dt>
		<dd class="text-right font-medium">{details.leadName}</dd>
	</dl>
	<span class="glass-rim opacity-60 [--rim-width:2px]" aria-hidden="true"></span>
</section>
