---
import type { BookingDetails } from '../../../lib/booking/booking-details';
import { formatMoney } from '../../../lib/email/templates/layout';

interface Props {
	details: BookingDetails;
	refunded: number;
}

const { details, refunded } = Astro.props;
const isActive = details.status === 'confirmed';

const headline = isActive
	? { label: 'A pagar el día del tour', value: details.balanceAmount > 0 ? formatMoney(details.balanceAmount) : 'Nada, ya está pagado' }
	: refunded > 0
		? { label: 'Reembolsado', value: formatMoney(refunded) }
		: null;

const rows = [
	{ label: 'Total', value: formatMoney(details.total) },
	{ label: 'Pagado al reservar', value: formatMoney(details.depositAmount) },
	{ label: 'Seguro de cancelación', value: details.hasInsurance ? 'Incluido' : 'No incluido' },
];
---

<section aria-labelledby="pagos-reserva" class="rounded-[2rem] bg-surface p-6 sm:p-8">
	<h2 id="pagos-reserva" class="text-lg font-semibold tracking-[-0.02em] text-primary">Pagos</h2>

	{headline && (
		<div class="mt-4">
			<p class="text-sm text-muted">{headline.label}</p>
			<p class="mt-1 text-3xl font-semibold tracking-[-0.03em] text-primary tabular-nums">{headline.value}</p>
		</div>
	)}

	<dl class="mt-4 divide-y divide-border">
		{rows.map((row) => (
			<div class="flex justify-between gap-6 py-3 text-sm">
				<dt class="text-muted">{row.label}</dt>
				<dd class="text-right font-medium text-primary tabular-nums">{row.value}</dd>
			</div>
		))}
	</dl>

	{isActive && details.pickupFeePending && (
		<p class="mt-2 text-sm leading-relaxed text-secondary">El suplemento de recogida depende de tu hotel. Te lo confirmamos antes del tour.</p>
	)}
</section>
