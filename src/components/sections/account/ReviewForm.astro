---
import { Picture } from 'astro:assets';
import { ArrowLeft, Check, Clock } from '@lucide/astro';
import Button from '../../ui/Button.astro';
import GlassBadge from '../../ui/GlassBadge.astro';
import ReviewFormFields from './ReviewFormFields.astro';
import { bookingPhoto, formatBookingDate, suggestedAuthorName } from '../../../lib/account/bookings';
import type { BookingDetails } from '../../../lib/booking/booking-details';

interface Props {
	details: BookingDetails;
	token: string;
	alreadyReviewed: boolean;
	signedIn: boolean;
}

const { details, token, alreadyReviewed, signedIn } = Astro.props;
const photo = bookingPhoto(details.productKey);
const doneHref = signedIn ? '/account' : '/';
const doneLabel = signedIn ? 'Volver a mis reservas' : 'Volver al inicio';

const blockedMessage = alreadyReviewed
	? { icon: Check, title: 'Ya tenemos tu opinión', text: 'Gracias por contarnos qué tal fue. La publicaremos en cuanto la revisemos.' }
	: details.status !== 'completed'
		? { icon: Clock, title: 'Todavía no puedes opinar', text: 'Podrás dejar tu opinión cuando hayas hecho la excursión.' }
		: null;

const statusView = 'flex flex-col items-center py-10 text-center';
const statusIcon = 'liquid-glass flex size-14 items-center justify-center bg-white/70 text-accent';
const statusTitle = 'mt-6 text-2xl font-semibold tracking-[-0.03em] text-primary outline-none';
const statusText = 'mx-auto mt-3 max-w-sm text-secondary';
---

<div class="px-4 pt-8 sm:px-6 sm:pt-12">
	<div class="mx-auto max-w-5xl">
		{signedIn && (
			<a
				href="/account"
				class="inline-flex animate-fade-up items-center gap-2 text-sm font-medium text-muted transition-colors duration-300 ease-smooth hover:text-primary"
				style="animation-delay: 60ms"
			>
				<ArrowLeft size={16} stroke-width={1.75} aria-hidden="true" />
				Mis reservas
			</a>
		)}

		<div class:list={['grid gap-4 lg:grid-cols-12', signedIn && 'mt-5']}>
			<header
				class="relative isolate flex min-h-[14rem] animate-fade-up flex-col justify-end overflow-hidden rounded-[2rem] bg-primary p-6 text-white sm:min-h-[18rem] sm:p-8 lg:col-span-5 lg:min-h-0"
				style="animation-delay: 120ms"
			>
				{photo && (
					<Picture
						src={photo}
						alt=""
						formats={['avif', 'webp']}
						widths={[640, 960, 1280]}
						sizes="(min-width: 1024px) 26rem, 100vw"
						priority
						pictureAttributes={{ class: 'absolute inset-0 -z-20' }}
						class="size-full object-cover brightness-90"
					/>
				)}
				<div class="absolute inset-0 -z-10 bg-linear-to-t from-primary/85 via-primary/25 to-transparent" aria-hidden="true"></div>
				<GlassBadge overPhoto class="absolute top-5 left-5">Reserva {details.code}</GlassBadge>
				<p class="text-sm text-white/80">{formatBookingDate(details.tourDate)}</p>
				<h1 class="mt-1 text-3xl leading-[1.05] font-semibold tracking-[-0.04em] text-balance sm:text-4xl">¿Qué tal fue {details.productName}?</h1>
				<span class="glass-rim [--rim-width:3px]" aria-hidden="true"></span>
			</header>

			<section class="animate-fade-up rounded-[2rem] bg-surface p-5 sm:p-7 lg:col-span-7" style="animation-delay: 180ms">
				{blockedMessage ? (
					<div class={statusView}>
						<span class={statusIcon}><blockedMessage.icon size={24} stroke-width={1.75} aria-hidden="true" /></span>
						<h2 class={statusTitle}>{blockedMessage.title}</h2>
						<p class={statusText}>{blockedMessage.text}</p>
						<Button href={doneHref} variant="outline" class="mt-8">{doneLabel}</Button>
					</div>
				) : (
					<ReviewFormFields code={details.code} token={token} suggestedAuthor={suggestedAuthorName(details.leadName)} doneHref={doneHref} doneLabel={doneLabel} />
				)}
			</section>
		</div>
	</div>
</div>
