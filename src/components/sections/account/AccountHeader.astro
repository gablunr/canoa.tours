---
import { LogOut } from '@lucide/astro';

interface Props {
	title: string;
	intro: string;
	current: 'bookings' | 'profile';
}

const { title, intro, current } = Astro.props;

const tabs = [
	{ id: 'bookings', label: 'Mis reservas', href: '/account' },
	{ id: 'profile', label: 'Perfil', href: '/account/profile' },
] as const;
---

<header class="px-4 pt-8 sm:px-6 sm:pt-12 md:pt-16">
	<div class="mx-auto max-w-5xl">
		<nav aria-label="Tu cuenta" class="flex animate-fade-up flex-wrap items-center gap-2 max-lg:justify-center" style="animation-delay: 60ms">
			{tabs.map((tab) => (
				<a
					href={tab.href}
					aria-current={tab.id === current ? 'page' : undefined}
					class:list={[
						'inline-flex h-10 items-center rounded-full px-4 text-sm font-medium sm:px-5 transition-colors duration-300 ease-smooth outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2',
						tab.id === current ? 'bg-primary text-white' : 'bg-surface text-secondary hover:bg-ink-100 hover:text-primary',
					]}
				>
					{tab.label}
				</a>
			))}
			<form method="post" action="/api/auth/sign-out" class="ml-4 lg:ml-auto">
				<button
					type="submit"
					class="liquid-glass inline-flex h-10 cursor-pointer items-center gap-2 bg-ink-200/55 px-3 text-sm sm:px-4 font-medium text-secondary backdrop-blur-xl backdrop-saturate-150 transition-colors duration-300 ease-smooth outline-none hover:bg-ink-200/80 hover:text-primary focus-visible:ring-2 focus-visible:ring-accent"
				>
					<LogOut size={16} stroke-width={1.75} aria-hidden="true" />
					<span class="max-sm:sr-only">Cerrar sesión</span>
				</button>
			</form>
		</nav>

		<h1
			class="mt-8 animate-fade-up bg-linear-to-b from-primary to-muted bg-clip-text pb-1 text-3xl max-lg:text-center sm:mt-12 leading-[1.02] font-semibold tracking-[-0.04em] text-balance text-transparent sm:text-5xl lg:text-6xl"
			style="animation-delay: 120ms"
		>
			{title}
		</h1>
		<p
			class="mt-3 max-w-2xl animate-fade-up font-display text-base leading-[1.45] max-lg:mx-auto max-lg:text-center max-lg:text-balance sm:mt-5 sm:text-lg tracking-[-0.01em] text-pretty text-secondary"
			style="animation-delay: 180ms"
		>
			{intro}
		</p>
	</div>
</header>
