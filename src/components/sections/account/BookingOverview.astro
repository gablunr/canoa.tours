---
import { ArrowUpRight } from '@lucide/astro';
import { bookingTourDetails, formatTourDay } from '../../../lib/account/bookings';
import type { BookingDetails } from '../../../lib/booking/booking-details';
import { peopleSummary, pickupSummary } from '../../../lib/email/templates/layout';

interface Props {
	details: BookingDetails;
}

const { details } = Astro.props;
const bring = details.status === 'confirmed' ? (bookingTourDetails(details.productKey)?.bring ?? []) : [];

const facts = [
	{ label: 'Fecha', value: formatTourDay(details.tourDate) },
	{ label: 'Recogida', value: pickupSummary(details) },
	...(details.returnAt ? [{ label: 'Vuelta', value: `Hacia las ${details.returnAt}` }] : []),
	{ label: 'Personas', value: peopleSummary(details) },
	{ label: 'Hotel', value: details.hotel ?? 'Por confirmar' },
	...(details.zone ? [{ label: 'Zona', value: details.zone }] : []),
];
---

<section aria-labelledby="tu-excursion" class="rounded-[2rem] bg-surface p-6 sm:p-8">
	<div class="flex flex-wrap items-center justify-between gap-3">
		<h2 id="tu-excursion" class="text-lg font-semibold tracking-[-0.02em] text-primary">Tu excursión</h2>
		{details.tourPath !== '/' && (
			<a
				href={details.tourPath}
				class="liquid-glass inline-flex h-9 shrink-0 items-center gap-1.5 bg-ink-200/55 pr-3 pl-4 text-[13px] font-medium text-secondary backdrop-blur-xl backdrop-saturate-150 transition-colors duration-300 ease-smooth outline-none hover:bg-ink-200/80 hover:text-primary focus-visible:ring-2 focus-visible:ring-accent"
			>
				Ver la excursión
				<ArrowUpRight size={15} stroke-width={2} aria-hidden="true" />
			</a>
		)}
	</div>

	<dl class="mt-6 grid grid-cols-2 gap-x-4 gap-y-5 sm:grid-cols-3 sm:gap-x-6">
		{facts.map((fact) => (
			<div>
				<dt class="text-xs text-muted">{fact.label}</dt>
				<dd class="mt-1 text-[15px] leading-snug font-medium text-primary">{fact.value}</dd>
			</div>
		))}
	</dl>

	{bring.length > 0 && (
		<div class="mt-8 border-t border-border pt-6">
			<h3 class="text-sm font-semibold text-primary">Qué llevar</h3>
			<ul class="mt-3 flex flex-wrap gap-2">
				{bring.map((item) => (
					<li class="rounded-full bg-white px-3.5 py-1.5 text-sm text-secondary">{item}</li>
				))}
			</ul>
		</div>
	)}
</section>
