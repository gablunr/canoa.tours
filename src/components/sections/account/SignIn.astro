---
import { Picture } from 'astro:assets';
import Button from '../../ui/Button.astro';
import TextField from '../../ui/form/TextField.astro';
import turquoisePierBeach from '../../../assets/images/home/turquoise-pier-beach.jpg';

interface Props {
	next: string;
	linkFailed: boolean;
}

const { next, linkFailed } = Astro.props;
---

<section class="relative isolate -mt-14 flex min-h-[max(32rem,78svh)] items-center justify-center overflow-hidden bg-primary px-4 pt-24 pb-28 sm:px-6">
	<Picture
		src={turquoisePierBeach}
		alt=""
		formats={['avif', 'webp']}
		widths={[640, 960, 1280, 1920, 2560]}
		sizes="100vw"
		priority
		pictureAttributes={{ class: 'absolute inset-0 -z-20' }}
		class="size-full object-cover brightness-75 saturate-110 contrast-105"
	/>
	<div class="film-grain absolute inset-0 -z-20 opacity-90" aria-hidden="true"></div>
	<div
		class="absolute inset-0 -z-10 bg-linear-to-b from-primary/70 via-primary/25 via-35% to-primary/40"
		aria-hidden="true"
	></div>

	<div
		class="liquid-glass w-full max-w-sm animate-fade-up rounded-[2rem] bg-primary/25 p-6 text-white sm:p-8"
		style="animation-delay: 550ms"
		data-sign-in
	>
		<div data-sign-in-step="form">
			<h1 class="font-display text-2xl font-semibold tracking-[-0.03em]" tabindex="-1" data-sign-in-heading>
				Accede a tu cuenta
			</h1>
			<p class="mt-2 text-sm leading-relaxed text-white/75">
				Te enviamos un enlace a tu email para entrar, sin contraseña.
			</p>

			{linkFailed && (
				<p role="alert" class="mt-5 rounded-2xl bg-white/10 px-4 py-3 text-sm text-sun-200">
					Ese enlace ya no sirve. Pide uno nuevo.
				</p>
			)}

			<form class="mt-6" novalidate data-sign-in-form>
				<input type="hidden" name="next" value={next} />
				<TextField
					tone="glass"
					label="Email"
					name="email"
					type="email"
					autocomplete="email"
					inputmode="email"
					placeholder="tu@email.com"
					required
					requiredMessage="Escribe tu email."
					invalidMessage="Revisa el email, parece incompleto."
				/>
				<p class="mt-3 text-sm text-sun-200" role="alert" data-sign-in-error hidden></p>
				<Button type="submit" variant="on-dark" class="mt-6 w-full" data-sign-in-submit>
					Enviar enlace
				</Button>
			</form>

			<p class="mt-5 text-center text-xs text-white/65">Usa el email con el que hiciste tu reserva.</p>
		</div>

		<div data-sign-in-step="sent" hidden>
			<h1 class="font-display text-2xl font-semibold tracking-[-0.03em]" tabindex="-1" data-sign-in-sent-heading>
				Revisa tu email
			</h1>
			<p class="mt-2 text-sm leading-relaxed text-white/75">
				Te hemos enviado un enlace a <strong class="font-medium text-white" data-sign-in-email></strong>. Púlsalo
				para entrar.
			</p>
			<p class="mt-4 text-xs text-white/65">Si no te llega en unos minutos, mira en la carpeta de spam.</p>
			<Button variant="outline-on-dark" class="mt-6 w-full" data-sign-in-reset>Usar otro email</Button>
		</div>
	</div>
</section>

<script>
	import { initSignIn } from '../../../scripts/account/sign-in';

	document.querySelectorAll<HTMLElement>('[data-sign-in]').forEach(initSignIn);
</script>
