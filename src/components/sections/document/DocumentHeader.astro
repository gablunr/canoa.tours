---
import { formatUpdatedDate, readingMinutes, updatedIsoDate, type DocumentEntry } from '../../../data/pages/documents';

interface Props {
	entry: DocumentEntry;
}

const { entry } = Astro.props;
const { title, description } = entry.data;
---

<header class="px-4 pt-16 sm:px-6 md:pt-24">
	<div class="mx-auto max-w-6xl">
		<div class="mx-auto max-w-3xl text-center">
			<h1
				class="animate-fade-up bg-linear-to-b from-primary to-muted bg-clip-text text-4xl leading-[1.05] font-medium text-transparent tracking-tight text-balance md:text-5xl"
				style="animation-delay: 60ms"
			>
				{title}
			</h1>
			<p class="mt-5 animate-fade-up text-lg leading-relaxed text-muted" style="animation-delay: 120ms">
				{description}
			</p>
		</div>

		<dl
			class="mt-10 flex animate-fade-up flex-wrap justify-center gap-x-12 gap-y-4 border-t border-border/60 pt-6 text-center text-sm"
			style="animation-delay: 180ms"
		>
			<div>
				<dt class="text-muted">Última actualización</dt>
				<dd class="mt-1 font-medium text-primary">
					<time datetime={updatedIsoDate(entry)}>{formatUpdatedDate(entry)}</time>
				</dd>
			</div>
			<div>
				<dt class="text-muted">Lectura</dt>
				<dd class="mt-1 font-medium text-primary">{readingMinutes(entry)} min</dd>
			</div>
		</dl>
	</div>
</header>
