---
import { ChevronDown } from '@lucide/astro';
import ClientPagination from '../../ui/ClientPagination.astro';
import FilterPills from '../../ui/FilterPills.astro';
import ReviewCard from '../../ui/cards/ReviewCard.astro';
import type { Review } from '../../../data/reviews/reviews';
import { reviewPageSize, reviewRatingFilters } from '../../../data/reviews/review-filters';
import { destinations } from '../../../data/tours/destinations';
import { tourProductKey } from '../../../data/tours/tours';

interface Props {
	id: string;
	reviews: Review[];
	showTour?: boolean;
	tourFilter?: boolean;
	listClass?: string;
	class?: string;
}

const { id, reviews, showTour = true, tourFilter = false, listClass, class: className } = Astro.props;

const hasControls = reviews.length > reviewPageSize;
const ratingOptions = reviewRatingFilters.map((filter) => ({
	value: filter.value,
	label: filter.label,
	count: reviews.filter((review) => filter.matches(review.rating)).length,
}));

const tourGroups = destinations
	.map((destination) => {
		const tours = destination.tours.flatMap((tour) => {
			const count = reviews.filter((review) => review.tour.destination.id === destination.id && review.tour.tour.slug === tour.slug).length;
			return count > 0 ? [{ value: `${destination.id}/${tour.slug}`, label: `${tour.name} (${count})` }] : [];
		});
		return { label: destination.name, tours };
	})
	.filter((group) => group.tours.length > 0);
const showTourFilter = hasControls && tourFilter && tourGroups.flatMap((group) => group.tours).length > 1;
const tourSelectId = `${id}-excursion`;
---

<div id={id} class:list={['grid scroll-mt-24 gap-5', className]} data-review-browser>
	{hasControls && (
		<div class="flex flex-wrap items-center gap-3 max-lg:justify-center">
			<FilterPills legend="Filtrar por puntuación" name={`${id}-rating`} options={ratingOptions} checked="all" />
			{showTourFilter && (
				<span class="liquid-glass relative inline-flex h-9 items-center bg-white/60 text-[13px] font-medium text-secondary transition-colors duration-300 ease-smooth hover:bg-white/90 hover:text-primary has-focus-visible:ring-2 has-focus-visible:ring-accent">
					<label for={tourSelectId} class="sr-only">Excursión</label>
					<select id={tourSelectId} class="h-full cursor-pointer appearance-none bg-transparent pr-9 pl-4 outline-none" data-review-tour-filter>
						<option value="">Todas las excursiones</option>
						{tourGroups.map((group) => (
							<optgroup label={group.label}>
								{group.tours.map((tour) => <option value={tour.value}>{tour.label}</option>)}
							</optgroup>
						))}
					</select>
					<ChevronDown size={14} stroke-width={2} class="pointer-events-none absolute top-1/2 right-3.5 -translate-y-1/2" aria-hidden="true" />
				</span>
			)}
			<ClientPagination label="Páginas de opiniones" class="lg:ml-auto" />
		</div>
	)}

	<ul class:list={['grid gap-4', listClass]}>
		{reviews.map((review, index) => (
			<li data-review-item data-rating={review.rating} data-tour={tourProductKey(review.tour)} hidden={index >= reviewPageSize}>
				<ReviewCard review={review} showTour={showTour} />
			</li>
		))}
	</ul>

	<p class="text-[15px] leading-relaxed text-muted max-lg:text-center" data-review-browser-empty hidden>No hay opiniones con ese filtro.</p>
</div>

<script>
	import { initReviewBrowser } from '../../../scripts/reviews/review-browser';

	document.querySelectorAll<HTMLElement>('[data-review-browser]').forEach(initReviewBrowser);
</script>
