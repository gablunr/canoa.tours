---
import type { GuideBlock } from '../../../data/guides/guide-content';

interface Props {
	blocks: GuideBlock[];
}

const { blocks } = Astro.props;
---

{blocks.map((block) => {
	if (block.type === 'paragraph') return <p set:html={block.html} />;
	if (block.type === 'list') return <ul>{block.items.map((item) => <li set:html={item} />)}</ul>;
	return (
		<div class="overflow-x-auto">
			<table>
				<thead>
					<tr>{block.head.map((cell) => <th scope="col">{cell}</th>)}</tr>
				</thead>
				<tbody>
					{block.rows.map((row) => (
						<tr>{row.map((cell) => <td set:html={cell} />)}</tr>
					))}
				</tbody>
			</table>
		</div>
	);
})}
