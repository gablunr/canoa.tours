---
import SectionNav from '../../ui/SectionNav.astro';
import GuideCard from '../../ui/cards/GuideCard.astro';
import { guideCountLabel, guideGroups, guideHref, guideReadingTime } from '../../../data/guides/guides';

const navLinks = guideGroups.map((group) => ({
	href: `#${group.anchor}`,
	label: group.title,
	count: { value: group.guides.length, label: guideCountLabel(group.guides.length) },
}));
---

<div class="pt-16 lg:pt-24">
	<SectionNav label="Guías por destino" links={navLinks} />

	<div class="px-4 sm:px-6">
		<div class="mx-auto max-w-6xl">
			{guideGroups.map((group) => {
				const titleId = `${group.anchor}-title`;
				return (
					<section id={group.anchor} aria-labelledby={titleId} class="mt-12 scroll-mt-24 lg:mt-16">
						<div data-reveal class="border-t border-border/60 pt-8">
							<p class="text-sm text-muted">{guideCountLabel(group.guides.length)}</p>
							<h2 id={titleId} class="mt-1 text-3xl leading-[1.1] font-semibold tracking-[-0.03em] text-primary md:text-4xl">
								{group.title}
							</h2>
						</div>

						<ul class="-mx-4 mt-8 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 pb-4 [scrollbar-width:none] sm:mx-0 sm:grid sm:snap-none sm:grid-cols-2 sm:gap-x-5 sm:gap-y-10 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-3 [&::-webkit-scrollbar]:hidden">
							{group.guides.map((guide) => (
								<li data-reveal class="w-[82%] max-w-sm shrink-0 snap-start sm:w-auto sm:max-w-none">
									<GuideCard
										href={guideHref(guide)}
										title={guide.title}
										description={guide.description}
										image={guide.image}
										badges={[guideReadingTime(guide)]}
									/>
								</li>
							))}
						</ul>
					</section>
				);
			})}
		</div>
	</div>
</div>
