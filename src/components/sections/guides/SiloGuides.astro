---
import PageSection from '../page/PageSection.astro';
import GuideCard from '../../ui/cards/GuideCard.astro';
import { isGuidePublished } from '../../../data/guides/guide-content';
import { guideHref, guideReadingTime, siloGuides } from '../../../data/guides/guides';
import type { Destination } from '../../../data/tours/destinations';

interface Props {
	destination: Destination;
	id: string;
	title?: string;
	limit?: number;
	rail?: boolean;
	class?: string;
}

const { destination, id, limit = 3, rail = false, class: className } = Astro.props;
const title =
	Astro.props.title ?? (destination.kind === 'place' ? `Guías para ir a ${destination.name}` : `Guías de ${destination.name.toLowerCase()}`);
const guides = siloGuides(destination.id)
	.toSorted((a, b) => Number(isGuidePublished(b.slug)) - Number(isGuidePublished(a.slug)))
	.slice(0, limit);

const listClass = !rail
	? 'grid gap-x-5 gap-y-10 max-sm:px-5 sm:grid-cols-2 lg:grid-cols-3'
	: guides.length === 1
		? 'grid max-w-md'
		: [
				'-mx-4 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 pb-4 [scrollbar-width:none] sm:mx-0 sm:grid sm:snap-none sm:grid-cols-2 sm:gap-x-5 sm:gap-y-10 sm:overflow-visible sm:px-0 sm:pb-0 [&::-webkit-scrollbar]:hidden',
				guides.length === 3 && 'sm:max-lg:[&>li:last-child:nth-child(odd)]:col-span-2 lg:grid-cols-3',
			];
const itemClass = rail && guides.length > 1 ? 'w-[82%] max-w-sm shrink-0 snap-start sm:w-auto sm:max-w-none' : undefined;
---

{guides.length > 0 && (
	<PageSection id={id} title={title} class={className}>
		<ul class:list={listClass}>
			{guides.map((guide) => (
				<li data-reveal class={itemClass}>
					<GuideCard
						href={guideHref(guide)}
						title={guide.title}
						description={guide.description}
						image={guide.image}
						badges={[isGuidePublished(guide.slug) ? guideReadingTime(guide) : 'En preparación']}
						frameClass="h-96"
						sizes={rail ? '36rem' : undefined}
					/>
				</li>
			))}
		</ul>
	</PageSection>
)}
