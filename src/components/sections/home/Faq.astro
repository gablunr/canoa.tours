---
import GlassAccordion from '../../ui/GlassAccordion.astro';
import { faqs } from '../../../data/faq';
---

<section aria-labelledby="faq-title" class="px-4 pt-24 sm:px-6 lg:pt-32">
	<div class="mx-auto max-w-6xl">
		<h2
			id="faq-title"
			data-reveal
			class="mx-auto max-w-3xl bg-linear-to-b from-primary to-muted bg-clip-text text-center text-4xl leading-[1.05] text-transparent font-semibold tracking-[-0.03em] text-balance md:text-5xl"
		>
			Preguntas frecuentes sobre excursiones en Punta Cana
		</h2>

		<ul class="mx-auto mt-10 grid max-w-3xl gap-3 lg:mt-14">
			{faqs.map((faq) => (
				<li data-reveal>
					<GlassAccordion name="faq" summary={faq.question} text={faq.answer} link={faq.link} />
				</li>
			))}
		</ul>
	</div>
</section>
