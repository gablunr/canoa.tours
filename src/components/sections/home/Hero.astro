---
import { company } from '../../../data/company';
---

<section class="px-4 pt-24 pb-24 sm:px-6 md:pt-32 md:pb-32">
	<div class="mx-auto max-w-3xl text-center">
		<h1 class="animate-fade-up text-4xl leading-[1.05] font-medium tracking-tight text-balance md:text-6xl">
			{company.brandName}
		</h1>
		<p class="mt-6 animate-fade-up text-lg leading-relaxed text-muted" style="animation-delay: 80ms">
			{company.description}
		</p>
	</div>
</section>
