---
import { MapPin } from '@lucide/astro';
import GlassBadge from '../../ui/GlassBadge.astro';
import GlassButton from '../../ui/GlassButton.astro';
import PhotoHero from '../page/PhotoHero.astro';
import palmBeach from '../../../assets/images/home/caribbean-palm-beach.jpg';
import { company } from '../../../data/site/company';
import { lowestFromPrice } from '../../../data/tours/destinations';
import { catalogLink } from '../../../data/site/navigation';
import { formatPrice } from '../../../lib/format';

const [mainArea] = company.serviceAreas;
---

<PhotoHero
	title="Excursiones en Punta Cana con recogida en tu hotel"
	image={palmBeach}
	imageAlt="Playa caribeña de arena blanca con palmeras y mar turquesa bajo un cielo azul despejado"
	imageClass="object-[center_65%]"
	sizes="(max-aspect-ratio: 3/2) 146vh, 100vw"
>
	{mainArea && (
		<GlassBadge slot="badge" class="animate-fade-up" style="animation-delay: 550ms">
			<MapPin size={13} stroke-width={2.25} aria-hidden="true" />
			{mainArea.name}
		</GlassBadge>
	)}
	Isla Saona, Samaná, Santo Domingo, Isla Catalina, buggies y Coco Bongo. Salidas desde Punta Cana y Bayahibe,
	desde {formatPrice(lowestFromPrice)} por persona.
	<GlassButton
		slot="actions"
		href={catalogLink.href}
		class="mt-10 animate-fade-up focus-visible:ring-white focus-visible:ring-offset-primary"
		style="animation-delay: 790ms"
	>
		Ver excursiones y precios
	</GlassButton>
</PhotoHero>
