---
import Button from '../../ui/Button.astro';
---

<section class="px-4 pt-16 pb-24 sm:px-6 md:pt-24 md:pb-32">
	<div class="mx-auto max-w-2xl text-center">
		<p class="animate-fade-up text-sm text-muted">Error 404</p>
		<h1 class="mt-4 animate-fade-up text-4xl leading-[1.05] font-medium tracking-tight text-balance md:text-5xl" style="animation-delay: 80ms">
			No encontramos esta página
		</h1>
		<p class="mx-auto mt-6 max-w-lg animate-fade-up text-base leading-relaxed text-muted" style="animation-delay: 160ms">
			Puede que la dirección esté mal escrita o que la página haya cambiado de lugar.
		</p>
		<div class="mt-10 flex animate-fade-up justify-center" style="animation-delay: 240ms">
			<Button href="/">Ir al inicio</Button>
		</div>
	</div>
</section>
