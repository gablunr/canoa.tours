---
import { MessageSquareText } from '@lucide/astro';
import TourSection from './TourSection.astro';
import RatingBadge from '../../ui/RatingBadge.astro';
import UnderlineLink from '../../ui/UnderlineLink.astro';
import ReviewBrowser from '../reviews/ReviewBrowser.astro';
import { reviewStats, reviewsForTour } from '../../../data/reviews/reviews';
import { reviewFormAnchor } from '../../../data/reviews/reviews-page';
import type { TourDetails } from '../../../data/tours/tours';
import { routes } from '../../../data/site/routes';

interface Props {
	details: TourDetails;
}

const { details } = Astro.props;

const tourReviews = reviewsForTour(details);
const stats = reviewStats(tourReviews);
const reviewFormHref = `${routes.reviews}#${reviewFormAnchor}`;
---

<TourSection id="opiniones" title="Opiniones">
	{stats ? (
		<div class="flex flex-col gap-6">
			<p class="max-lg:text-center"><RatingBadge stats={stats} /></p>
			<ReviewBrowser id="tour-reviews" reviews={tourReviews} showTour={false} listClass="sm:grid-cols-2" />
			<p class="max-lg:text-center">
				<UnderlineLink href={reviewFormHref} tone="accent">Deja tu opinión</UnderlineLink>
			</p>
		</div>
	) : (
		<div class="flex flex-col items-center rounded-[1.75rem] border border-border/60 p-6 text-center sm:p-8">
			<span class="flex size-12 items-center justify-center rounded-full bg-surface text-accent-strong" aria-hidden="true">
				<MessageSquareText size={22} stroke-width={1.75} />
			</span>
			<p class="mt-4 font-display text-lg font-medium tracking-[-0.01em] text-primary">Todavía no hay opiniones de esta excursión</p>
			<p class="mt-2 max-w-md text-[15px] leading-relaxed text-pretty text-muted">
				Solo publicamos opiniones de personas que viajaron con nosotros. Si ya la hiciste, cuéntanos qué tal.
			</p>
			<p class="mt-5">
				<UnderlineLink href={reviewFormHref} tone="accent">Deja tu opinión</UnderlineLink>
			</p>
		</div>
	)}
</TourSection>
