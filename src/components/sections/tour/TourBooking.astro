---
import { Check, Minus, Plus } from '@lucide/astro';
import Button from '../../ui/Button.astro';
import UnderlineLink from '../../ui/UnderlineLink.astro';
import Checkbox from '../../ui/form/Checkbox.astro';
import PhoneField from '../../ui/form/PhoneField.astro';
import SelectField from '../../ui/form/SelectField.astro';
import TextField from '../../ui/form/TextField.astro';
import BookingSummary from './booking/BookingSummary.astro';
import DatePicker from './booking/DatePicker.astro';
import HotelPicker from './booking/HotelPicker.astro';
import {
	bookingPolicy,
	cancellationInsurancePriceLabel,
	cancellationNoticeLabel,
	savedCardNotice,
} from '../../../data/booking/booking-policy';
import { company, whatsappMessageHref } from '../../../data/site/company';
import { cancellationsLink, howToBookLink, legalLinks, privacyPolicyHref } from '../../../data/site/navigation';
import { childPriceLabel, scheduleLabel, type TourDetails } from '../../../data/tours/tours';
import { quoteBooking } from '../../../lib/booking/pricing';
import { formatPrice } from '../../../lib/format';

interface Props {
	details: TourDetails;
}

const { details } = Astro.props;
const { whatsapp } = company;
const child = details.childPrice;
const childLabel = childPriceLabel(details);
const daysLabel = scheduleLabel(details.days);
const perGroup = details.pricePer === 'group';
const productKey = details.productKey;
const supportHref = whatsapp
	? whatsappMessageHref(whatsapp, `Hola, quiero reservar ${details.title}.`)
	: `mailto:${company.email}`;
const supportLabel = whatsapp ? 'Escríbenos por WhatsApp' : 'Escríbenos por email';
const privacyLink = legalLinks.find((link) => link.href === privacyPolicyHref);
const termsLink = legalLinks.find((link) => link.href !== privacyPolicyHref);

const initialQuote = quoteBooking({
	pricingMode: perGroup ? 'per_group' : 'per_person',
	adultPrice: details.price,
	childPrice: child?.amount ?? null,
	adults: 2,
	children: 0,
	infants: 0,
	depositType: 'fixed',
	depositValue: details.deposit,
	pickupFeePerPerson: null,
	insurance: false,
	insurancePricePerPerson: bookingPolicy.cancellationInsurancePrice,
	coupon: null,
});

const hasBalance = initialQuote.balanceAmount > 0;
const paymentChoices = [
	{
		value: 'deposit',
		label: 'Pagar el depósito',
		detail: `${formatPrice(initialQuote.depositAmount)} ahora y ${formatPrice(initialQuote.balanceAmount)} el día de la excursión`,
	},
	{ value: 'full', label: 'Pagar todo ahora', detail: formatPrice(initialQuote.total) },
];

const counters = [
	{ name: 'adults', label: perGroup ? 'Personas' : 'Adultos', value: 2, min: 1, max: 30, invalidMessage: 'Tiene que ir al menos una persona.' },
	...(child
		? [{ name: 'children', label: `Niños (${child.fromAge} a ${child.toAge})`, value: 0, min: 0, max: 20, invalidMessage: 'Revisa cuántos niños van.' }]
		: []),
	{ name: 'infants', label: 'Bebés', note: `Menores de ${child?.fromAge ?? 3}, gratis`, value: 0, min: 0, max: 10, invalidMessage: 'Revisa cuántos bebés van.' },
];

const stepTitle = 'text-xs font-medium tracking-[0.08em] text-muted uppercase outline-none';
const textButton =
	'cursor-pointer text-sm font-medium text-primary underline decoration-border-strong underline-offset-4 transition-colors duration-300 ease-smooth outline-none hover:decoration-primary focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2';
const glassControl =
	'liquid-glass cursor-pointer bg-surface/70 text-primary transition-colors duration-300 ease-smooth outline-none hover:bg-ink-100 focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-40';
---

<div
	class="rounded-[2rem] border border-border/60 bg-background p-6 shadow-[0_24px_48px_-24px_color-mix(in_oklab,var(--color-primary)_35%,transparent)] max-lg:mx-auto max-lg:max-w-md sm:p-7 md:max-lg:max-w-3xl md:max-lg:p-10"
>
	<p class="text-sm text-muted">Desde</p>
	<p class="flex flex-wrap items-baseline gap-x-2 font-display text-4xl font-semibold tracking-[-0.03em] text-primary">
		{formatPrice(details.price)}
		<span class="text-base leading-snug font-normal tracking-normal text-muted">{details.priceUnit}</span>
	</p>
	{childLabel && <p class="mt-1 text-sm text-muted">{childLabel}</p>}

	<noscript>
		<style is:inline>[data-booking-form] { display: none !important; }</style>
		<p class="mt-6 text-[15px] leading-relaxed text-secondary">Activa JavaScript para reservar online.</p>
		<Button href={supportHref} variant="outline" size="lg" class="mt-3 w-full">{supportLabel}</Button>
	</noscript>

	<form
		data-booking-form
		novalidate
		class="mt-6 grid grid-cols-[minmax(0,1fr)] gap-5"
		data-product-key={productKey}
		data-pricing-mode={perGroup ? 'per_group' : 'per_person'}
		data-adult-price={details.price}
		data-child-price={child?.amount ?? ''}
		data-deposit-value={details.deposit}
		data-insurance-price={bookingPolicy.cancellationInsurancePrice}
	>
		<div data-booking-unavailable hidden class="grid gap-3">
			<p class="text-[15px] leading-relaxed text-secondary">La reserva online no está disponible para esta excursión.</p>
			<Button href={supportHref} variant="outline" size="lg" class="w-full">{supportLabel}</Button>
		</div>

		<section data-step-panel="1" aria-labelledby="booking-step-1-title" class="grid grid-cols-[minmax(0,1fr)] gap-5">
			<h3 id="booking-step-1-title" tabindex="-1" class={stepTitle}>Paso 1 de 3</h3>

			<DatePicker hint={`Sale: ${daysLabel.toLowerCase()}`} requiredMessage="Elige el día de la excursión." />

			<div class="grid gap-3">
				{counters.map((counter) => (
					<div data-field data-invalid-message={counter.invalidMessage}>
						<div class="flex items-center justify-between gap-4">
							<label for={`field-${counter.name}`} class="text-sm font-medium text-primary">
								{counter.label}
								{counter.note && <span class="block text-xs font-normal text-muted">{counter.note}</span>}
							</label>
							<div class="flex h-12 w-36 shrink-0 items-center justify-between rounded-full border border-border-strong p-1">
								<button type="button" data-step="-1" data-target={counter.name} aria-label={`Quitar ${counter.label.toLowerCase()}`} class:list={[glassControl, 'flex size-9.5 items-center justify-center']}>
									<Minus size={16} aria-hidden="true" />
								</button>
								<input
									type="number"
									id={`field-${counter.name}`}
									name={counter.name}
									value={counter.value}
									min={counter.min}
									max={counter.max}
									inputmode="numeric"
									required
									aria-describedby={`field-${counter.name}-error`}
									class="w-10 [appearance:textfield] bg-transparent text-center text-base font-medium text-primary tabular-nums focus:outline-none [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
								/>
								<button type="button" data-step="1" data-target={counter.name} aria-label={`Añadir ${counter.label.toLowerCase()}`} class:list={[glassControl, 'flex size-9.5 items-center justify-center']}>
									<Plus size={16} aria-hidden="true" />
								</button>
							</div>
						</div>
						<p id={`field-${counter.name}-error`} data-field-error class="mt-2 text-xs text-error" hidden></p>
					</div>
				))}
			</div>

			<HotelPicker requiredMessage="Dinos en qué hotel te hospedas." />

			<BookingSummary quote={initialQuote} />

			<Button type="submit" size="lg" class="liquid-glass w-full">Continuar</Button>
		</section>

		<section data-step-panel="2" hidden aria-labelledby="booking-step-2-title" class="grid grid-cols-[minmax(0,1fr)] gap-5">
			<h3 id="booking-step-2-title" tabindex="-1" class={stepTitle}>Paso 2 de 3</h3>

			<div class="flex items-start justify-between gap-4 rounded-[1.25rem] border border-border/60 p-4 text-sm">
				<p class="min-w-0 leading-relaxed">
					<span data-selection-date class="block font-medium text-primary"></span>
					<span data-selection-detail class="block text-muted"></span>
				</p>
				<button type="button" data-step-back class={textButton}>Cambiar</button>
			</div>

			<TextField
				name="leadName"
				label="Nombre y apellidos"
				autocomplete="name"
				required
				minlength={2}
				maxlength={120}
				requiredMessage="Escribe tu nombre y apellidos."
				invalidMessage="Escribe tu nombre completo."
			/>
			<TextField
				name="email"
				type="email"
				label="Email"
				autocomplete="email"
				inputmode="email"
				required
				requiredMessage="Escribe tu email para enviarte la reserva."
				invalidMessage="Revisa el email."
			/>
			<PhoneField requiredMessage="Escribe un teléfono de contacto." invalidMessage="Revisa el teléfono." />
			<SelectField name="country" label="País" options={[]} placeholder="Elige tu país" autocomplete="country" />

			<Checkbox name="insurance">
				Seguro de cancelación, {cancellationInsurancePriceLabel} por persona
				<span class="block text-xs">Cancela o cambia la fecha hasta {cancellationNoticeLabel} antes</span>
			</Checkbox>

			<div data-coupon>
				<div data-field data-coupon-field>
					<label for="field-couponCode" class="flex items-baseline justify-between gap-3 text-sm font-medium text-primary">
						Cupón
						<span class="text-xs font-normal text-muted">Opcional</span>
					</label>
					<div class="mt-2 flex gap-2">
						<input
							id="field-couponCode"
							name="couponCode"
							autocomplete="off"
							autocapitalize="characters"
							spellcheck="false"
							maxlength="64"
							aria-describedby="field-couponCode-error"
							class="block h-12 w-full min-w-0 rounded-2xl border border-border-strong bg-background px-4 text-base text-primary uppercase transition-colors duration-300 ease-smooth placeholder:text-subtle hover:border-muted focus:border-primary focus:outline-none aria-invalid:border-error"
						/>
						<Button variant="outline" data-coupon-apply class="shrink-0">Aplicar</Button>
					</div>
					<p id="field-couponCode-error" data-field-error class="mt-2 text-xs text-error" hidden></p>
				</div>
				<div data-coupon-applied hidden class="flex items-center justify-between gap-3">
					<span class="inline-flex min-w-0 items-center gap-2 rounded-full bg-surface px-4 py-2 text-sm font-medium text-primary">
						<Check size={16} stroke-width={2} class="shrink-0 text-accent" aria-hidden="true" />
						<span data-coupon-code class="truncate"></span>
					</span>
					<button type="button" data-coupon-remove class={textButton}>Quitar</button>
				</div>
			</div>

			<fieldset data-payment-choice hidden={!hasBalance} class="grid gap-2.5">
				<legend class="mb-2.5 text-sm font-medium text-primary">¿Cómo quieres pagar?</legend>
				{paymentChoices.map((choice) => (
					<label class="flex cursor-pointer items-start gap-3 rounded-2xl border border-border/70 bg-background p-4 transition-colors duration-300 ease-smooth hover:border-muted has-checked:border-primary has-checked:bg-surface">
						<input type="radio" name="paymentOption" value={choice.value} checked={choice.value === 'deposit'} class="mt-0.5 size-5 shrink-0 cursor-pointer accent-primary" />
						<span class="min-w-0 text-sm leading-relaxed">
							<span class="block font-medium text-primary">{choice.label}</span>
							<span data-payment-detail={choice.value} class="block text-muted">{choice.detail}</span>
						</span>
					</label>
				))}
			</fieldset>

			<div>
				<Checkbox name="acceptTerms" required requiredMessage="Acepta los términos para poder reservar.">
					Acepto los <UnderlineLink tone="accent" href={termsLink?.href} target="_blank">términos</UnderlineLink> y el <UnderlineLink tone="accent" href={privacyLink?.href} target="_blank">aviso de privacidad</UnderlineLink>
				</Checkbox>
				<p data-saved-card-notice hidden={!hasBalance} class="mt-2 text-xs leading-relaxed text-muted">{savedCardNotice}</p>
			</div>

			<BookingSummary quote={initialQuote} />

			<Button type="submit" size="lg" data-continue-payment class="liquid-glass w-full">Continuar al pago</Button>

			<p data-booking-error role="alert" hidden class="text-sm leading-relaxed text-error"></p>

			<button type="button" data-step-back class:list={[textButton, 'justify-self-center']}>Volver</button>
		</section>

		<section data-step-panel="3" hidden aria-labelledby="booking-step-3-title" class="grid grid-cols-[minmax(0,1fr)] gap-5">
			<h3 id="booking-step-3-title" tabindex="-1" class={stepTitle}>Paso 3 de 3</h3>

			<p data-payment-intro class="text-[15px] leading-relaxed text-primary"></p>

			<div>
				<p data-payment-loading class="flex h-32 animate-pulse items-center justify-center rounded-[1.25rem] bg-surface text-sm text-muted">Cargando el pago…</p>
				<div data-payment-element></div>
			</div>

			<p data-payment-error role="alert" hidden class="text-sm leading-relaxed text-error"></p>

			<div>
				<Button type="submit" size="lg" data-confirm-payment disabled class="liquid-glass w-full">Pagar</Button>
				<p class="mt-3 text-center text-xs leading-relaxed text-muted">Pago seguro con Stripe. Nosotros nunca vemos los datos de tu tarjeta.</p>
			</div>

			<button type="button" data-payment-back class:list={[textButton, 'justify-self-center']}>Volver</button>
		</section>
	</form>

	<ul class="mt-5 grid gap-2 border-t border-border/60 pt-5 text-[13px] text-muted">
		<li class="flex gap-2">
			<Check size={16} stroke-width={2} class="mt-px shrink-0 text-accent" aria-hidden="true" />
			Cancela hasta {cancellationNoticeLabel} antes con el seguro de cancelación ({cancellationInsurancePriceLabel} por persona)
		</li>
		<li class="flex gap-2">
			<Check size={16} stroke-width={2} class="mt-px shrink-0 text-accent" aria-hidden="true" />
			Si hace mal tiempo, cambiamos la fecha sin coste
		</li>
	</ul>
	<p class="mt-4 flex flex-wrap gap-x-5 gap-y-2 max-lg:justify-center">
		<UnderlineLink href={howToBookLink.href}>{howToBookLink.label}</UnderlineLink>
		<UnderlineLink href={cancellationsLink.href}>{cancellationsLink.label}</UnderlineLink>
	</p>
</div>

<script>
	import { initTourBooking } from '../../../scripts/tour/tour-booking';

	document.querySelectorAll<HTMLFormElement>('[data-booking-form]').forEach(initTourBooking);
</script>
