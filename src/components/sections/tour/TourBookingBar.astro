---
import ArrowButton from '../../ui/ArrowButton.astro';
import type { TourDetails } from '../../../data/tours/tours';
import { formatPrice } from '../../../lib/format';

interface Props {
	details: TourDetails;
}

const { details } = Astro.props;
---

<div
	data-booking-bar
	inert
	class="fixed inset-x-3 bottom-[max(0.75rem,env(safe-area-inset-bottom))] z-40 translate-y-[calc(100%+1.5rem)] transition-transform duration-500 ease-smooth data-visible:translate-y-0 lg:hidden"
>
	<div class="mx-auto flex h-16 max-w-md items-center justify-between gap-4 rounded-[1.375rem] bg-notch pr-2 pl-5 text-white shadow-lg">
		<p class="min-w-0 text-xs text-muted-on-dark">
			Desde
			<span class="flex min-w-0 items-baseline gap-1.5">
				<span class="font-display text-lg leading-tight font-semibold text-white">{formatPrice(details.price)}</span>
				<span class="truncate">{details.priceUnit}</span>
			</span>
		</p>
		<ArrowButton href="#reservar" size="sm" class="shrink-0 focus-visible:ring-offset-notch">Reservar</ArrowButton>
	</div>
</div>

<script>
	import { initBookingBar } from '../../../scripts/tour/tour-booking';

	const bar = document.querySelector<HTMLElement>('[data-booking-bar]');
	if (bar) initBookingBar(bar);
</script>
