---
import Layout from '../../../layouts/Layout.astro';
import LiquidWarpFilter from '../../ui/LiquidWarpFilter.astro';
import TourHeader from './TourHeader.astro';
import TourHighlights from './TourHighlights.astro';
import TourFacts from './TourFacts.astro';
import TourBooking from './TourBooking.astro';
import TourIncludes from './TourIncludes.astro';
import TourItinerary from './TourItinerary.astro';
import TourBring from './TourBring.astro';
import TourPickup from './TourPickup.astro';
import TourReviews from './TourReviews.astro';
import TourFaq from './TourFaq.astro';
import TourSiblings from './TourSiblings.astro';
import SiloGuides from '../guides/SiloGuides.astro';
import TourBookingBar from './TourBookingBar.astro';
import { destinationHref } from '../../../data/tours/destinations';
import { routes } from '../../../data/site/routes';
import { tourDetailsHref, tourFaqs, tourPhoto, tourSeoDescription, tourSeoTitle, type TourDetails } from '../../../data/tours/tours';
import { canonicalUrl } from '../../../lib/seo/seo';
import { tripNode } from '../../../lib/seo/pillar-schema';
import { faqSchema, pageNodeIds, reference, tripItinerarySchema } from '../../../lib/seo/structured-data';

interface Props {
	details: TourDetails;
}

const { details } = Astro.props;
const href = tourDetailsHref(details);
const url = canonicalUrl(href);
const faqs = tourFaqs(details);
const photo = tourPhoto(details);
const itinerary = tripItinerarySchema(details.itinerary.map((step) => ({ name: step.title, description: step.text })));
const trip = { ...(await tripNode(details)), mainEntityOfPage: reference(pageNodeIds(url).webPage), ...(itinerary && { itinerary }) };
---

<Layout
	title={tourSeoTitle(details)}
	description={tourSeoDescription(details)}
	image={photo && { src: photo, alt: details.imageAlt }}
	pageType="FAQPage"
	mainEntity={faqSchema(faqs)}
	graph={[trip]}
	modifiedAt={details.updatedAt}
	breadcrumbs={[
		{ name: 'Excursiones', path: routes.catalog },
		{ name: details.destination.name, path: destinationHref(details.destination) },
		{ name: details.title, path: href },
	]}
>
	<LiquidWarpFilter />
	<article data-tour>
		<TourHeader details={details} />
		<div class="px-4 pt-14 sm:px-6 md:px-12 md:pt-20 lg:px-6">
			<div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[minmax(0,1fr)_23rem] lg:grid-rows-[auto_1fr] lg:gap-x-16 xl:gap-x-20">
				<div class="mx-auto w-full max-w-3xl space-y-12 lg:col-start-1 lg:mx-0 lg:max-w-none">
					<TourHighlights details={details} />
					<TourFacts details={details} />
				</div>
				<aside id="reservar" aria-label="Reservar" class="scroll-mt-20 lg:col-start-2 lg:row-span-2 lg:row-start-1">
					<div data-booking-sticky class="lg:sticky lg:top-24">
						<TourBooking details={details} />
					</div>
				</aside>
				<div class="mx-auto w-full max-w-3xl space-y-12 lg:col-start-1 lg:mx-0 lg:max-w-none">
					<TourIncludes details={details} />
					<TourItinerary details={details} />
					<TourBring details={details} />
					<TourPickup details={details} />
					<TourReviews details={details} />
					<TourFaq faqs={faqs} />
				</div>
			</div>
		</div>
	</article>
	<TourSiblings details={details} />
	<SiloGuides destination={details.destination} id="tour-guides-title" class="pb-8" />
	<TourBookingBar details={details} />
</Layout>

<script>
	import { initStickyCard } from '../../../scripts/tour/tour-booking';

	const sticky = document.querySelector<HTMLElement>('[data-booking-sticky]');
	if (sticky) initStickyCard(sticky);
</script>
