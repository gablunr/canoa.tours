---
import FactGrid from '../../ui/FactGrid.astro';
import HeroBreadcrumb from '../../ui/HeroBreadcrumb.astro';
import PhotoHero from '../page/PhotoHero.astro';
import palmBeach from '../../../assets/images/home/caribbean-palm-beach.jpg';
import { destinationHref } from '../../../data/tours/destinations';
import { routes } from '../../../data/site/routes';
import { durationLabel, pickupLabel, scheduleLabel, tourAnswer, tourPhoto, type TourDetails } from '../../../data/tours/tours';
import { formatPrice } from '../../../lib/format';

interface Props {
	details: TourDetails;
}

const { details } = Astro.props;
const { destination, tour } = details;
const photo = tourPhoto(details) ?? palmBeach;
const facts = [
	{ label: 'Precio desde', value: formatPrice(details.price), note: details.priceUnit },
	{ label: 'Duración', value: durationLabel(details) },
	{ label: 'Salidas', value: scheduleLabel(details.days) },
	{ label: 'Recogida', value: pickupLabel(details) },
];
---

<PhotoHero data-tour-photo title={details.title} image={photo} imageAlt={details.imageAlt} introClass="max-w-3xl" compact dim>
	<HeroBreadcrumb
		slot="badge"
		items={[
			{ label: 'Excursiones', href: routes.catalog },
			{ label: destination.name, href: destinationHref(destination) },
			{ label: tour.name },
		]}
	/>
	{tourAnswer(details)}
	<FactGrid slot="actions" facts={facts} overPhoto class="mt-10 w-full animate-fade-up" style="animation-delay: 790ms" />
</PhotoHero>
