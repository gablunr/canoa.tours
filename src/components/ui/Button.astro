---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'button'>, 'class' | 'type'> {
	href?: string;
	target?: HTMLAttributes<'a'>['target'];
	rel?: string;
	type?: 'button' | 'submit';
	variant?: 'solid' | 'on-dark' | 'outline' | 'outline-on-dark' | 'glass';
	size?: 'sm' | 'md' | 'lg';
	class?: string;
}

const { href, type = 'button', variant = 'solid', size = 'md', class: className, ...attributes } = Astro.props;
const Element = href ? 'a' : 'button';

const variants = {
	solid: 'bg-accent text-white hover:bg-accent-strong',
	'on-dark': 'bg-white text-primary hover:bg-white/85',
	outline: 'border border-border text-primary hover:border-primary',
	'outline-on-dark': 'border border-white/35 text-white hover:border-white hover:bg-white/10',
	glass: 'liquid-glass bg-primary/25 text-white hover:bg-primary/40',
};

const sizes = {
	sm: 'h-10 px-5 text-[13px]',
	md: 'h-12 px-6 text-sm',
	lg: 'h-14 px-7 text-sm',
};
---

<Element
	{...attributes}
	href={href}
	type={href ? undefined : type}
	class:list={[
		'inline-flex cursor-pointer items-center justify-center rounded-full font-medium transition duration-300 ease-smooth outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background active:scale-[0.97] disabled:pointer-events-none disabled:opacity-60',
		variants[variant],
		sizes[size],
		className,
	]}
>
	<slot />
</Element>
