---
import { ChevronRight } from '@lucide/astro';

interface Props {
	items: { label: string; href?: string }[];
	slot?: string;
}

const { items } = Astro.props;
---

<nav
	aria-label="Ruta de navegación"
	class="liquid-glass max-w-full animate-fade-up overflow-hidden bg-primary/20 backdrop-blur-md"
	style="animation-delay: 550ms"
>
	<ol class="flex items-center gap-1 overflow-x-auto overscroll-x-contain px-3 py-1 font-display text-xs font-medium whitespace-nowrap text-white/80 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
		{items.map((item, index) => (
			<Fragment>
				{index > 0 && (
					<li aria-hidden="true" class="shrink-0"><ChevronRight size={12} stroke-width={2.25} class="text-white/60" /></li>
				)}
				{item.href ? (
					<li class="shrink-0"><a href={item.href} class="rounded-full px-1 transition-colors duration-300 ease-smooth hover:text-white">{item.label}</a></li>
				) : (
					<li aria-current="page" class="shrink-0 px-1 text-white">{item.label}</li>
				)}
			</Fragment>
		))}
	</ol>
</nav>
