---
import { ArrowUpRight } from '@lucide/astro';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<span
	class:list={[
		'pointer-events-none flex size-10 shrink-0 items-center justify-center rounded-full bg-white text-primary transition-transform duration-500 ease-smooth group-hover:rotate-45',
		className,
	]}
	aria-hidden="true"
>
	<ArrowUpRight size={18} stroke-width={2} />
</span>
