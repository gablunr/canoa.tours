---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'article'> {
	number: number;
	title: string;
	text: string;
	image: ImageMetadata;
}

const { number, title, text, image, class: className, ...attributes } = Astro.props;
---

<article {...attributes} class:list={['clear-glass flex h-full flex-col rounded-[1.75rem] p-6', className]}>
	<span class="absolute top-6 left-6 flex size-9 items-center justify-center rounded-full bg-primary font-display text-sm font-semibold text-white">
		{number}
	</span>

	<span class="mx-auto block size-20 shrink-0 drop-shadow-xl lg:size-24">
		<Image
			src={image}
			alt=""
			widths={[160, 192, 288, 400]}
			sizes="(min-width: 1024px) 6rem, 5rem"
			class="size-full"
		/>
	</span>

	<h3 class="mt-5 text-lg leading-tight font-semibold tracking-[-0.02em] text-balance text-primary">{title}</h3>
	<p class="mt-1.5 text-[15px] leading-relaxed text-pretty text-secondary">{text}</p>
</article>
