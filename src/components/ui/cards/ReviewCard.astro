---
import { Image } from 'astro:assets';
import { BadgeCheck } from '@lucide/astro';
import StarRating from '../StarRating.astro';
import { formatLongDate, toIsoDate } from '../../../lib/format';
import { imageSource } from '../../../lib/images';
import type { Review } from '../../../data/reviews/reviews';

interface Props {
	review: Review;
	showTour?: boolean;
	class?: string;
}

const { review, showTour = true, class: className } = Astro.props;

const initials = review.author
	.split(/\s+/)
	.filter(Boolean)
	.slice(0, 2)
	.map((word) => word.charAt(0).toUpperCase())
	.join('');
const textIsLong = review.text.length > 150 || review.text.split('\n').length > 2;
const replyIsLong = (review.reply?.length ?? 0) > 90;
const expandable = textIsLong || replyIsLong;
const expandId = `opinion-${review.id}-completa`;
const expandedClamp = 'group-has-[:checked]/review:line-clamp-none';
---

<figure class:list={['group/review flex h-full flex-col rounded-[1.5rem] bg-chip p-5', className]}>
	{expandable && <input type="checkbox" id={expandId} class="sr-only" />}

	<figcaption class="flex items-center gap-3">
		<span class="relative flex size-9 shrink-0 items-center justify-center overflow-hidden rounded-full bg-background text-[13px] font-semibold text-primary" aria-hidden="true">
			{initials}
			{review.authorAvatarUrl && (
				<img src={review.authorAvatarUrl} alt="" width="36" height="36" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover" />
			)}
		</span>
		<div class="min-w-0">
			<p class="truncate text-[15px] font-semibold text-primary">{review.author}</p>
			<p class="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-[13px] text-muted">
				<StarRating rating={review.rating} size={12} />
				<time datetime={toIsoDate(review.date)}>{formatLongDate(review.date)}</time>
				{review.verified && (
					<span class="inline-flex items-center gap-1 text-accent-strong">
						<BadgeCheck size={13} stroke-width={2} aria-hidden="true" />
						Reserva verificada
					</span>
				)}
			</p>
		</div>
	</figcaption>

	<blockquote class="mt-3">
		{review.title && <p class="text-[15px] font-semibold tracking-[-0.01em] text-primary">{review.title}</p>}
		<p class:list={['text-sm leading-relaxed text-pretty whitespace-pre-line text-secondary', review.title && 'mt-0.5', textIsLong && ['line-clamp-3', expandedClamp]]}>
			{review.text}
		</p>
	</blockquote>

	{review.photos.length > 0 && (
		<ul class="mt-3 flex flex-wrap gap-1.5" aria-label={`Fotos de ${review.author}`}>
			{review.photos.map((photo, index) => (
				<li>
					<a href={photo.src} target="_blank" rel="noopener" class="block overflow-hidden rounded-lg outline-none focus-visible:ring-2 focus-visible:ring-accent">
						<Image
							{...imageSource(photo)}
							alt={`Foto ${index + 1} de ${review.author}`}
							widths={[48, 96]}
							sizes="3rem"
							class="size-12 object-cover transition-transform duration-300 ease-smooth hover:scale-105"
						/>
					</a>
				</li>
			))}
		</ul>
	)}

	{review.reply && (
		<div class="mt-3 rounded-xl bg-background px-3 py-2">
			<p class="text-[11px] font-medium text-muted">Respuesta de Canoa Tours</p>
			<p class:list={['text-[13px] leading-relaxed whitespace-pre-line text-secondary', replyIsLong && ['line-clamp-2', expandedClamp]]}>{review.reply}</p>
		</div>
	)}

	{expandable && (
		<label
			for={expandId}
			class="mt-2 cursor-pointer self-start rounded-full text-[13px] font-medium text-accent-strong hover:text-accent group-has-[:checked]/review:hidden group-has-[:focus-visible]/review:ring-2 group-has-[:focus-visible]/review:ring-accent"
		>
			Leer completa
		</label>
	)}

	{showTour && (
		<p class="mt-auto pt-3">
			<a
				href={review.tourHref}
				class="inline-flex rounded-full bg-background px-3 py-1.5 text-[13px] font-medium text-secondary transition-colors duration-300 ease-smooth hover:bg-primary hover:text-white"
			>
				{review.tourTitle}
			</a>
		</p>
	)}
</figure>
