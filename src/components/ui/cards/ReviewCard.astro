---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import StarRating from '../StarRating.astro';
import UnderlineLink from '../UnderlineLink.astro';
import { formatLongDate, toIsoDate } from '../../../lib/format';

interface Props {
	author: string;
	avatar: ImageMetadata;
	rating: number;
	text: string;
	tourTitle: string;
	tourHref: string;
	source: string;
	date?: Date;
	url?: string;
	class?: string;
}

const { author, avatar, rating, text, tourTitle, tourHref, source, date, url, class: className } = Astro.props;
---

<figure class:list={['flex h-full flex-col rounded-[1.75rem] bg-chip p-7 lg:p-8', className]}>
	<div class="flex flex-wrap items-center justify-between gap-3">
		<StarRating rating={rating} />
		<a
			href={tourHref}
			class="inline-flex rounded-full bg-background px-3 py-1.5 text-[13px] font-medium text-secondary transition-colors duration-300 ease-smooth hover:bg-primary hover:text-white"
		>
			{tourTitle}
		</a>
	</div>

	<blockquote class="mt-6 flex-1 text-[15px] leading-relaxed text-pretty text-secondary">
		<p>{text}</p>
	</blockquote>

	<figcaption class="mt-8 flex flex-wrap items-end justify-between gap-x-4 gap-y-2">
		<div class="flex items-center gap-3">
			<Image src={avatar} alt="" widths={[112, 168, 224]} sizes="3.5rem" class="size-14 shrink-0 rounded-full object-cover" />
			<div>
				<p class="font-semibold text-primary">{author}</p>
				{date && <time datetime={toIsoDate(date)} class="mt-0.5 block text-sm text-muted">{formatLongDate(date)}</time>}
			</div>
		</div>
		{url && (
			<UnderlineLink href={url} tone="accent" target="_blank" rel="noopener">
				Ver en {source}<span class="sr-only">, reseña de {author}</span>
			</UnderlineLink>
		)}
	</figcaption>
</figure>
