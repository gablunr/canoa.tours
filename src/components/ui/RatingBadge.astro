---
import StarRating from './StarRating.astro';
import { formatRating, reviewCountLabel, type ReviewStats } from '../../data/reviews/review-model';

interface Props {
	stats: ReviewStats;
	class?: string;
}

const { stats, class: className } = Astro.props;
---

<span class:list={['inline-flex items-center gap-3 rounded-full bg-chip py-2 pr-4 pl-3.5 text-sm text-secondary', className]}>
	<StarRating rating={stats.rating} decorative />
	<span><strong class="font-semibold text-primary">{formatRating(stats.rating)}</strong> de media, {reviewCountLabel(stats.count)}</span>
</span>
