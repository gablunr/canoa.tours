---
import StarRating from './StarRating.astro';

interface Props {
	rating: number;
	ratingLabel: string;
	source: string;
	countLabel: string;
	href?: string;
	class?: string;
}

const { rating, ratingLabel, source, countLabel, href, class: className } = Astro.props;

const Tag = href ? 'a' : 'span';
---

<Tag
	href={href}
	target={href ? '_blank' : undefined}
	rel={href ? 'noopener' : undefined}
	class:list={[
		'inline-flex items-center gap-3 rounded-full bg-chip py-2 pr-4 pl-3.5 text-sm text-secondary',
		href && 'transition-colors duration-300 ease-smooth hover:bg-border',
		className,
	]}
>
	<StarRating rating={rating} decorative />
	<span><strong class="font-semibold text-primary">{ratingLabel}</strong> en {source}, {countLabel}</span>
</Tag>
