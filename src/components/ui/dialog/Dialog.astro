---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'dialog'>, 'class'> {
	size?: 'md' | 'lg';
}

const { size = 'md', ...attributes } = Astro.props;

const widths = {
	md: 'max-w-md',
	lg: 'max-w-lg',
};
---

<dialog
	{...attributes}
	class:list={[
		'm-auto max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] overflow-y-auto overscroll-contain rounded-[2rem] bg-transparent p-0 text-primary backdrop:bg-primary/60 backdrop:backdrop-blur-sm',
		widths[size],
	]}
>
	<div class="liquid-glass rounded-[2rem] bg-white/85 p-6 backdrop-blur-xl backdrop-saturate-150 [--glass-drop-shadow:0_0_#0000] sm:p-8">
		<slot />
	</div>
</dialog>
