---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'input'>, 'id' | 'class' | 'name'> {
	label: string;
	name: string;
	hint?: string;
	requiredMessage?: string;
	invalidMessage?: string;
	tone?: 'light' | 'glass';
}

const { label, name, hint, requiredMessage, invalidMessage, required, tone = 'light', ...attributes } = Astro.props;

const inputId = `field-${name}`;
const hintId = `${inputId}-hint`;
const errorId = `${inputId}-error`;
const describedBy = hint ? `${hintId} ${errorId}` : errorId;

const tones = {
	light: {
		label: 'text-primary',
		optional: 'text-muted',
		input: 'border-border-strong bg-background text-primary placeholder:text-subtle hover:border-muted focus:border-primary aria-invalid:border-error',
		hint: 'text-muted',
		error: 'text-error',
	},
	glass: {
		label: 'text-white',
		optional: 'text-white/60',
		input: 'border-white/25 bg-white/10 text-white placeholder:text-white/50 hover:border-white/45 focus:border-white aria-invalid:border-sun-300',
		hint: 'text-white/70',
		error: 'text-sun-200',
	},
};

const styles = tones[tone];
---

<div data-field data-required-message={requiredMessage} data-invalid-message={invalidMessage}>
	<label for={inputId} class:list={['flex items-baseline justify-between gap-3 text-sm font-medium', styles.label]}>
		{label}
		{!required && <span class:list={['text-xs font-normal', styles.optional]}>Opcional</span>}
	</label>
	<input
		{...attributes}
		id={inputId}
		name={name}
		required={required}
		aria-describedby={describedBy}
		class:list={[
			'mt-2 block h-12 w-full rounded-2xl border px-4 text-base transition-colors duration-300 ease-smooth focus:outline-none',
			styles.input,
		]}
	/>
	{hint && <p id={hintId} class:list={['mt-2 text-xs', styles.hint]}>{hint}</p>}
	<p id={errorId} data-field-error class:list={['mt-2 text-xs', styles.error]} hidden></p>
</div>
