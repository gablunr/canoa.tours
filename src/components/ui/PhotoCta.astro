---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import FluidBackground from './FluidBackground.astro';

interface Props {
	titleId: string;
	title: string;
	image: ImageMetadata;
	imageClass?: string;
}

const { titleId, title, image, imageClass } = Astro.props;
---

<section aria-labelledby={titleId} class="relative isolate mt-10 px-4 pt-32 pb-40 sm:px-6 lg:mt-14 lg:pt-40 lg:pb-48">
	<div class="pointer-events-none absolute inset-x-0 -top-40 bottom-0 -z-10 lg:-top-56">
		<FluidBackground class="text-accent/50" />
	</div>

	<div
		data-reveal
		class="liquid-glass relative mx-auto max-w-6xl overflow-hidden rounded-[1.75rem] px-6 py-20 text-center backdrop-blur-2xl backdrop-saturate-150 after:opacity-70 sm:px-12 sm:py-24 lg:rounded-[2.5rem] lg:px-16 lg:py-28"
	>
		<Picture
			src={image}
			alt=""
			formats={['avif', 'webp']}
			widths={[640, 960, 1280, 1920, 2560, 3200]}
			sizes="100vw"
			pictureAttributes={{ class: 'absolute inset-0 -z-20' }}
			class:list={['size-full object-cover saturate-110', imageClass]}
		/>
		<div class="film-grain absolute inset-0 -z-20 opacity-70" aria-hidden="true"></div>

		<div class="relative z-10">
			<h2
				id={titleId}
				class="bg-linear-to-b from-white from-30% to-ink-200 bg-clip-text pb-1 text-4xl leading-[1.05] font-semibold tracking-[-0.03em] text-balance text-transparent md:text-5xl"
			>
				{title}
			</h2>
			<p class="mx-auto mt-5 max-w-xl font-display text-base leading-[1.45] tracking-[-0.01em] text-balance text-white/85 sm:text-lg">
				<slot name="text" />
			</p>
			<div class="mt-9 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
				<slot name="actions" />
			</div>
		</div>
	</div>
</section>
