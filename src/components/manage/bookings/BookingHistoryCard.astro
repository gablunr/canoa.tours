---
import { formatDateTime, type HistoryEntry } from '../../../lib/manage/bookings-query';
import { surfacePanel } from '../glass-classes';

interface Props {
	entries: HistoryEntry[];
}

const { entries } = Astro.props;
---

<section aria-labelledby="historial-reserva" class:list={[surfacePanel, 'p-5']}>
	<h2 id="historial-reserva" class="text-base font-semibold tracking-[-0.02em] text-primary">Historial</h2>
	{entries.length === 0 ? (
		<p class="mt-3 text-sm text-secondary">Sin movimientos todavía.</p>
	) : (
		<ol class="mt-4 grid gap-0">
			{entries.map((entry, index) => (
				<li class="relative grid grid-cols-[auto_minmax(0,1fr)] gap-x-4">
					<span class="relative flex w-3 justify-center" aria-hidden="true">
						<span class:list={['relative z-10 mt-1.5 size-2.5 rounded-full', index === 0 ? 'bg-accent' : 'bg-ink-300']}></span>
						{index < entries.length - 1 && <span class="absolute top-4 bottom-0 w-px bg-border"></span>}
					</span>
					<div class="pb-4">
						<p class="text-sm font-medium text-primary">{entry.label}</p>
						{entry.detail && <p class="mt-0.5 text-xs text-secondary">{entry.detail}</p>}
						<p class="mt-0.5 text-[11px] text-muted">
							<time datetime={entry.createdAt}>{formatDateTime(entry.createdAt)}</time>, {entry.actor}
						</p>
					</div>
				</li>
			))}
		</ol>
	)}
</section>
