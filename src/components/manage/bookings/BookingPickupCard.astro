---
import { CircleAlert, StickyNote } from '@lucide/astro';
import type { BookingDetails } from '../../../lib/booking/booking-details';
import { pickupSummary } from '../../../lib/email/templates/layout';
import { glassButtonPrimary, surfacePanel } from '../glass-classes';

interface Props {
	details: BookingDetails;
	pickupNote: string | null;
}

const { details, pickupNote } = Astro.props;
const canEditTime = details.status === 'confirmed';
const pickupWindow = pickupSummary({ pickupTime: null, startTime: details.startTime, pickupTo: details.pickupTo });
const rows = [
	{ label: 'Hotel', value: details.hotel ?? 'Sin indicar' },
	{ label: 'Zona', value: details.zone ?? 'Sin zona' },
	{ label: 'Ventana', value: pickupWindow },
];
---

<section aria-labelledby="recogida-reserva" class:list={[surfacePanel, 'p-5']}>
	<div class="flex flex-wrap items-center justify-between gap-2">
		<h2 id="recogida-reserva" class="text-base font-semibold tracking-[-0.02em] text-primary">Recogida</h2>
		{details.pickupFeePending && (
			<span class="inline-flex h-6 items-center gap-1 rounded-full bg-sun-soft px-2.5 text-xs font-medium text-sun-strong">
				<CircleAlert size={12} stroke-width={2} aria-hidden="true" />
				Tarifa por calcular
			</span>
		)}
	</div>

	<dl class="mt-3 divide-y divide-border text-sm">
		{rows.map((row) => (
			<div class="flex items-baseline justify-between gap-4 py-2">
				<dt class="shrink-0 text-muted">{row.label}</dt>
				<dd class="min-w-0 text-right text-primary">{row.value}</dd>
			</div>
		))}
		{!canEditTime && (
			<div class="flex items-baseline justify-between gap-4 py-2">
				<dt class="shrink-0 text-muted">Hora exacta</dt>
				<dd class="min-w-0 text-right text-primary tabular-nums">{details.pickupTime ?? 'Sin fijar'}</dd>
			</div>
		)}
	</dl>

	{canEditTime && (
		<form class="mt-2 border-t border-border pt-3" data-pickup-time-form data-code={details.code}>
			<label for="hora-recogida" class="text-xs text-muted">Hora exacta de recogida</label>
			<div class="mt-1.5 flex items-center gap-2">
				<input
					id="hora-recogida"
					type="time"
					name="pickupTime"
					required
					value={details.pickupTime ?? ''}
					class="h-9 min-w-0 flex-1 rounded-full border border-border-strong bg-white px-4 text-sm text-primary tabular-nums outline-none transition-colors duration-300 ease-smooth hover:border-muted focus:border-primary"
				/>
				<button type="submit" class:list={[glassButtonPrimary, 'shrink-0']} data-busy-label="Guardando…">Guardar</button>
			</div>
			<p class="mt-2 text-xs text-error" role="alert" data-pickup-time-error hidden></p>
		</form>
	)}

	{pickupNote && (
		<p class="mt-3 flex items-start gap-2 rounded-2xl bg-white px-3 py-2 text-xs leading-relaxed text-secondary">
			<StickyNote size={13} stroke-width={1.75} class="mt-px shrink-0 text-muted" aria-hidden="true" />
			<span>{pickupNote}</span>
		</p>
	)}
</section>

<script>
	import { initPickupTimeForm } from '../../../scripts/manage/bookings-detail';

	document.querySelectorAll<HTMLFormElement>('[data-pickup-time-form]').forEach(initPickupTimeForm);
</script>
