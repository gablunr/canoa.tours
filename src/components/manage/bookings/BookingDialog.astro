---
import Dialog from '../../ui/dialog/Dialog.astro';
import DialogButton from '../../ui/dialog/DialogButton.astro';

interface Props {
	name: string;
	action: string;
	title: string;
	description?: string;
	submitLabel: string;
	busyLabel: string;
	danger?: boolean;
}

const { name, action, title, description, submitLabel, busyLabel, danger = false } = Astro.props;
const titleId = `dialogo-${name}`;
---

<Dialog aria-labelledby={titleId} data-dialog={name}>
	<form data-action={action} novalidate>
		<h3 id={titleId} class="text-xl font-semibold tracking-[-0.03em]">{title}</h3>
		{description && <p class="mt-3 text-sm leading-relaxed text-secondary">{description}</p>}
		{Astro.slots.has('default') && (
			<div class="mt-5 grid gap-4" data-dialog-fields>
				<slot />
			</div>
		)}
		<p class="mt-4 text-sm text-error" role="alert" data-dialog-error hidden></p>
		<p class="mt-4 rounded-2xl bg-accent-soft px-4 py-3 text-sm text-accent-strong" role="status" data-dialog-result hidden></p>
		<div class="mt-7 grid gap-2.5 sm:grid-cols-2">
			<DialogButton data-dialog-close>Volver</DialogButton>
			<DialogButton type="submit" variant={danger ? 'danger' : 'primary'} data-dialog-submit data-busy-label={busyLabel}>{submitLabel}</DialogButton>
		</div>
	</form>
</Dialog>
