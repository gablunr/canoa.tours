---
import { formatMoney } from '../../../lib/email/templates/layout';
import { formatDateTime, paymentKindLabels, paymentProviderLabels, paymentStatusLabels, type PaymentRow } from '../../../lib/manage/bookings-query';
import { surfacePanel } from '../glass-classes';

interface Props {
	payments: PaymentRow[];
}

const { payments } = Astro.props;

const statusTones: Record<string, string> = {
	succeeded: 'bg-accent-soft text-accent-strong',
	pending: 'bg-ink-100 text-secondary',
	failed: 'bg-[#fbe9e7] text-error',
};
const headerCell = 'pb-2 text-left text-xs font-medium text-muted';
---

<section aria-labelledby="pagos-reserva" class:list={[surfacePanel, 'p-5']}>
	<h2 id="pagos-reserva" class="text-base font-semibold tracking-[-0.02em] text-primary">Pagos</h2>
	{payments.length === 0 ? (
		<p class="mt-3 text-sm text-secondary">No hay pagos registrados.</p>
	) : (
		<>
			<table class="mt-3 hidden w-full text-sm sm:table">
				<thead>
					<tr>
						<th scope="col" class={headerCell}>Concepto</th>
						<th scope="col" class={headerCell}>Fecha</th>
						<th scope="col" class={headerCell}>Estado</th>
						<th scope="col" class:list={[headerCell, 'text-right']}>Importe</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-border border-t border-border">
					{payments.map((payment) => (
						<tr>
							<td class="py-2.5 pr-3">
								<p class="font-medium text-primary">{paymentKindLabels[payment.kind] ?? payment.kind}</p>
								<p class="text-xs text-muted">{paymentProviderLabels[payment.provider] ?? payment.provider}</p>
							</td>
							<td class="py-2.5 pr-3 whitespace-nowrap text-secondary">{formatDateTime(payment.createdAt)}</td>
							<td class="py-2.5 pr-3">
								<span class:list={['inline-flex h-6 items-center rounded-full px-2.5 text-xs font-medium', statusTones[payment.status] ?? statusTones.pending]}>
									{paymentStatusLabels[payment.status] ?? payment.status}
								</span>
							</td>
							<td class:list={['py-2.5 text-right font-medium whitespace-nowrap tabular-nums', payment.kind === 'refund' ? 'text-error' : 'text-primary']}>
								{payment.kind === 'refund' ? `−${formatMoney(payment.amount)}` : formatMoney(payment.amount)}
							</td>
						</tr>
					))}
				</tbody>
			</table>
			<ul class="mt-3 divide-y divide-border border-t border-border sm:hidden">
				{payments.map((payment) => (
					<li class="flex items-start justify-between gap-3 py-2.5 text-sm">
						<div>
							<p class="font-medium text-primary">{paymentKindLabels[payment.kind] ?? payment.kind}</p>
							<p class="text-xs text-muted">{formatDateTime(payment.createdAt)}, {(paymentStatusLabels[payment.status] ?? payment.status).toLowerCase()}</p>
						</div>
						<span class:list={['font-medium whitespace-nowrap tabular-nums', payment.kind === 'refund' ? 'text-error' : 'text-primary']}>
							{payment.kind === 'refund' ? `−${formatMoney(payment.amount)}` : formatMoney(payment.amount)}
						</span>
					</li>
				))}
			</ul>
		</>
	)}
</section>
