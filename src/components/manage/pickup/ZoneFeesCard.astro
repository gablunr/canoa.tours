---
import { formatPrice } from '../../../lib/format';
import { tourLimits } from '../../../lib/tours/tour-schema';
import { glassButtonPrimary, surfacePanel } from '../glass-classes';
import type { ZoneFeeGroup } from './pickup-data';

interface Props {
	zoneId: string;
	groups: ZoneFeeGroup[];
	canEdit: boolean;
}

const { zoneId, groups, canEdit } = Astro.props;
const servedCount = groups.flatMap((group) => group.tours).filter((tour) => tour.served).length;
const tourCount = groups.reduce((total, group) => total + group.tours.length, 0);
const feeLabel = (fee: number | null) => (fee === null ? 'No recogemos' : fee === 0 ? 'Gratis' : `${formatPrice(fee)} por persona`);
const feeInput =
	'h-9 w-full rounded-full border border-border-strong bg-background pr-3 pl-10 text-base text-primary tabular-nums transition-colors duration-300 ease-smooth hover:border-muted focus:border-primary focus:outline-none disabled:opacity-40 aria-invalid:border-error sm:text-sm';
---

<section aria-label="Tarifas de recogida" class:list={[surfacePanel, 'p-4 sm:p-5']}>
	<p class="text-sm text-secondary">Lo que paga cada persona por recogerla aquí. Se recoge en {servedCount} de {tourCount} excursiones.</p>

	{tourCount === 0 ? (
		<p class="mt-4 text-sm text-secondary">Todavía no hay excursiones.</p>
	) : (
		<form class="mt-3" data-fees-form data-zone-id={zoneId} novalidate>
			{canEdit && (
				<div class="flex items-center gap-3 border-b border-border pb-2 text-xs font-medium text-muted" aria-hidden="true">
					<span class="flex-1">Excursión</span>
					<span class="w-12 text-center">Recoge</span>
					<span class="w-24 sm:w-28">Por persona</span>
				</div>
			)}
			{groups.map((group) => (
				<fieldset class="mt-3">
					<legend class="text-xs font-semibold text-secondary">{group.destinationName}</legend>
					<ul class="mt-1 divide-y divide-border">
						{group.tours.map((tour) => (
							<li class="flex items-center gap-3 py-2" data-fee-row data-product-id={tour.productId}>
								<p class="line-clamp-2 min-w-0 flex-1 text-sm leading-snug text-primary">
									{tour.name}
									{tour.isDraft && <span class="ml-1.5 inline-flex h-5 items-center rounded-full bg-ink-100 px-2 align-middle text-xs font-medium text-muted">Borrador</span>}
								</p>
								{canEdit ? (
									<Fragment>
										<span class="flex w-12 shrink-0 justify-center">
											<input
												type="checkbox"
												class="size-5 cursor-pointer accent-primary"
												checked={tour.served}
												aria-label={`Recogemos aquí para ${tour.name}`}
												data-fee-served
											/>
										</span>
										<div class="relative w-24 shrink-0 sm:w-28">
											<span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-xs text-muted" aria-hidden="true">US$</span>
											<input
												id={`tarifa-${tour.productId}`}
												type="number"
												inputmode="decimal"
												min="0"
												max={tourLimits.maxPickupFee}
												step="0.01"
												value={tour.fee ?? 0}
												disabled={!tour.served}
												aria-label={`Tarifa por persona para ${tour.name}`}
												class={feeInput}
												data-fee-amount
											/>
										</div>
									</Fragment>
								) : (
									<p class:list={['shrink-0 text-sm tabular-nums', tour.served ? 'text-primary' : 'text-muted']}>{feeLabel(tour.fee)}</p>
								)}
							</li>
						))}
					</ul>
				</fieldset>
			))}

			{canEdit && (
				<Fragment>
					<p class="mt-4 text-sm text-error" role="alert" data-fees-error hidden></p>
					<div class="mt-4 flex items-center justify-end gap-3">
						<span class="text-xs text-muted" role="status" data-fees-status></span>
						<button type="submit" class={glassButtonPrimary} data-fees-submit>Guardar tarifas</button>
					</div>
				</Fragment>
			)}
		</form>
	)}
</section>
