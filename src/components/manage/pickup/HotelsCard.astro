---
import { Pencil, Plus, Search } from '@lucide/astro';
import { glassButton, glassCircle, glassControl, surfacePanel } from '../glass-classes';
import type { ZoneHotel } from './pickup-data';

interface Props {
	hotels: ZoneHotel[];
}

const { hotels } = Astro.props;
const bookingLabel = (count: number) => `${count} ${count === 1 ? 'reserva' : 'reservas'}`;
---

<section aria-label="Hoteles" class:list={[surfacePanel, 'p-3 sm:p-4']} data-hotels-card>
	<div class="flex gap-2">
		{hotels.length > 0 && (
			<label class:list={[glassControl, 'relative h-11 min-w-0 flex-1 hover:bg-ink-200/85 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-accent']}>
				<span class="sr-only">Buscar hoteles</span>
				<Search size={16} stroke-width={1.75} class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-muted" aria-hidden="true" />
				<input
					type="search"
					maxlength="80"
					placeholder="Buscar"
					autocomplete="off"
					class="h-full w-full min-w-0 rounded-full bg-transparent pr-4 pl-11 text-base font-normal outline-none placeholder:text-muted sm:text-[13px]"
					data-hotel-search
				/>
			</label>
		)}
		<button type="button" class:list={[glassButton, 'h-11 shrink-0', hotels.length === 0 && 'mr-auto']} data-add-hotels-open>
			<Plus size={15} stroke-width={2} aria-hidden="true" />
			Añadir
		</button>
	</div>

	{hotels.length === 0 ? (
		<p class="px-1 pt-4 pb-1 text-sm text-secondary">Esta zona todavía no tiene hoteles.</p>
	) : (
		<Fragment>
			<ul class="mt-2 divide-y divide-border" data-hotel-list>
				{hotels.map((hotel) => (
					<li class="flex items-center justify-between gap-3 py-2 pl-1" data-hotel-row data-search-name={hotel.name.toLocaleLowerCase('es')}>
						<div class="min-w-0">
							<p class:list={['truncate text-sm', hotel.active ? 'text-primary' : 'text-muted']}>{hotel.name}</p>
							{(!hotel.active || hotel.bookingCount > 0) && (
								<p class="mt-0.5 flex flex-wrap items-center gap-x-2 text-xs text-muted">
									{!hotel.active && <span class="inline-flex h-5 items-center rounded-full bg-ink-100 px-2 font-medium">Oculto</span>}
									{hotel.bookingCount > 0 && <span class="tabular-nums">{bookingLabel(hotel.bookingCount)}</span>}
								</p>
							)}
						</div>
						<button
							type="button"
							class:list={[glassCircle, 'shrink-0']}
							aria-label={`Editar ${hotel.name}`}
							title="Editar"
							data-hotel-edit
							data-hotel-id={hotel.id}
							data-hotel-name={hotel.name}
							data-hotel-zone={hotel.zoneId}
							data-hotel-active={String(hotel.active)}
							data-hotel-bookings={hotel.bookingCount}
						>
							<Pencil size={15} stroke-width={1.75} aria-hidden="true" />
						</button>
					</li>
				))}
			</ul>
			<p class="px-1 py-3 text-sm text-secondary" data-hotel-search-empty hidden>Ningún hotel coincide con la búsqueda.</p>
		</Fragment>
	)}
</section>
