---
import { ArrowUpDown, ChevronDown, MapPin, Plus } from '@lucide/astro';
import { glassButton, glassButtonPrimary, glassControl, glassGroup, glassOption } from '../glass-classes';
import type { PickupZone } from './pickup-data';

interface Props {
	zones: PickupZone[];
	selectedZoneId: string | null;
	canEditZones: boolean;
	zoneHref: (slug: string) => string;
}

const { zones, selectedZoneId, canEditZones, zoneHref } = Astro.props;
const hotelCountLabel = (count: number) => `${count} ${count === 1 ? 'hotel' : 'hoteles'}`;
---

<aside class="grid min-w-0 animate-fade-up gap-2.5 lg:sticky lg:top-24" style="animation-delay: 100ms">
	<div class="flex gap-2 lg:hidden">
		{zones.length > 0 && (
			<label class:list={[glassControl, 'relative h-11 min-w-0 flex-1 hover:bg-ink-200/85 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-accent']}>
				<span class="sr-only">Zona</span>
				<MapPin size={15} stroke-width={1.75} class="pointer-events-none absolute top-1/2 left-3.5 -translate-y-1/2 text-muted" aria-hidden="true" />
				<select class="h-full w-full min-w-0 cursor-pointer appearance-none truncate rounded-full bg-transparent pr-9 pl-9 text-base font-medium outline-none" data-zone-select>
					{zones.map((zone) => (
						<option value={zoneHref(zone.slug)} selected={zone.id === selectedZoneId}>
							{zone.name} ({hotelCountLabel(zone.hotelCount)})
						</option>
					))}
				</select>
				<ChevronDown size={16} stroke-width={1.75} class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-muted" aria-hidden="true" />
			</label>
		)}
		{canEditZones && zones.length > 1 && (
			<button type="button" class:list={[glassButton, 'size-11 shrink-0 px-0']} aria-label="Ordenar zonas" title="Ordenar zonas" data-reorder-open>
				<ArrowUpDown size={16} stroke-width={1.75} aria-hidden="true" />
			</button>
		)}
		{canEditZones && (
			<button type="button" class:list={[glassButtonPrimary, 'size-11 shrink-0 px-0']} aria-label="Nueva zona" title="Nueva zona" data-new-zone-open>
				<Plus size={17} stroke-width={2} aria-hidden="true" />
			</button>
		)}
	</div>

	{zones.length > 0 && (
		<nav aria-label="Zonas" class:list={[glassGroup, 'flex flex-col gap-1 rounded-[1.5rem] p-1.5 max-lg:hidden']}>
			{zones.map((zone) => (
				<a
					href={zoneHref(zone.slug)}
					class:list={[glassOption, 'group/tab h-10 justify-between px-4']}
					aria-current={zone.id === selectedZoneId ? 'page' : undefined}
					data-zone-link
				>
					<span class="truncate">{zone.name}</span>
					<span class="text-xs font-normal text-muted tabular-nums group-aria-[current=page]/tab:text-white/65">
						{zone.hotelCount}
						<span class="sr-only">{zone.hotelCount === 1 ? 'hotel' : 'hoteles'}</span>
					</span>
				</a>
			))}
		</nav>
	)}
	{canEditZones && (
		<div class="flex gap-2 max-lg:hidden">
			<button type="button" class:list={[glassButtonPrimary, 'flex-1']} data-new-zone-open>
				<Plus size={15} stroke-width={2} aria-hidden="true" />
				Nueva zona
			</button>
			{zones.length > 1 && (
				<button type="button" class:list={[glassButton, 'flex-1']} data-reorder-open>
					<ArrowUpDown size={14} stroke-width={2} aria-hidden="true" />
					Ordenar
				</button>
			)}
		</div>
	)}
</aside>
