---
import ListEditor from '../form/ListEditor.astro';
import TourEditorCard from './TourEditorCard.astro';
import TourTextAreaField from './TourTextAreaField.astro';
import TourTextField from './TourTextField.astro';
import type { TourEditorData } from './tour-editor-data';
import { saleMinimums, tourLimits } from '../../../lib/tours/tour-schema';

interface Props {
	data: TourEditorData;
}

const { data } = Astro.props;
const { content } = data.editable;
---

<TourEditorCard section="basics" title="Lo básico">
	<TourTextField
		label="Nombre"
		name="name"
		value={content.name}
		required
		minlength="3"
		maxlength={tourLimits.nameLength}
		counter
		autocomplete="off"
		hint="El título de la ficha, tal como sale arriba."
	/>
	<TourTextField
		label="Nombre corto"
		name="shortName"
		value={content.shortName}
		maxlength={tourLimits.shortNameLength}
		counter
		autocomplete="off"
		hint="Para menús, tablas y tarjetas."
	/>
	<TourTextAreaField
		label="Resumen"
		name="summary"
		value={content.summary}
		rows={3}
		maxlength={tourLimits.summaryLength}
		counter
		required
		hint="También es la descripción en Google. Lo ideal, de 80 a 170 caracteres."
	/>
	<ListEditor
		name="highlights"
		label="Lo mejor"
		itemLabel="punto"
		items={content.highlights}
		min={1}
		max={tourLimits.highlights}
		maxlength={tourLimits.listItemLength}
		suggestions={data.suggestions.highlights}
		hint={`Al menos ${saleMinimums.highlights} para ponerla a la venta.`}
	/>
</TourEditorCard>
