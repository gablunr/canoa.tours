---
import { Lock } from '@lucide/astro';
import type { TourEditorSectionId } from '../../../lib/tours/tour-schema';
import { surfacePanel } from '../glass-classes';
import { sectionAnchor } from './tour-editor-sections';

interface Props {
	section: TourEditorSectionId;
	title: string;
	description?: string;
	lockedNote?: string;
}

const { section, title, description, lockedNote } = Astro.props;
const anchor = sectionAnchor(section);
const titleId = `${anchor}-title`;
---

<section id={anchor} aria-labelledby={titleId} class:list={[surfacePanel, 'min-w-0 scroll-mt-20 p-5 sm:p-6 lg:scroll-mt-24']} data-editor-section={section}>
	<header>
		<h2 id={titleId} class="text-lg font-semibold tracking-[-0.02em] text-primary">{title}</h2>
		{description && <p class="mt-1 text-sm leading-relaxed text-secondary">{description}</p>}
		{lockedNote && (
			<p class="mt-3 flex items-center gap-2 text-xs font-medium text-muted">
				<Lock size={13} stroke-width={2} aria-hidden="true" />
				{lockedNote}
			</p>
		)}
	</header>
	<div class="mt-5 grid gap-5">
		<slot />
	</div>
</section>
