---
import { ArrowDown, ArrowUp, CircleDot, ExternalLink, ImageOff, Pencil, Star } from '@lucide/astro';
import type { TourListItem } from './tour-list-data';
import { glassCircle, glassTile } from '../glass-classes';

interface Props {
	tour: TourListItem;
}

const { tour } = Astro.props;
const { missingCount } = tour;

const chip = 'inline-flex h-5 items-center gap-1 rounded-full px-2 text-[11px] font-medium whitespace-nowrap';
const arrowButton = `${glassCircle} disabled:pointer-events-none disabled:opacity-40`;
const hasChips = tour.mostBookedPosition !== null || tour.pendingOnWeb || missingCount > 0;
---

<li
	class:list={[
		glassTile,
		'group/row flex items-center gap-3 p-1.5 pr-2 sm:pr-2.5',
	]}
	data-tour-row
	data-tour-id={tour.id}
	data-search={tour.searchText}
>
	<span class="block aspect-[4/3] w-14 shrink-0 overflow-hidden rounded-[0.625rem] bg-ink-200/60 sm:w-16">
		{tour.imageUrl ? (
			<img src={tour.imageUrl} alt="" loading="lazy" decoding="async" width="64" height="48" class="size-full object-cover" />
		) : (
			<span class="flex size-full items-center justify-center text-muted">
				<ImageOff size={14} stroke-width={1.75} aria-hidden="true" />
			</span>
		)}
	</span>

	<div class="min-w-0 flex-1">
		<h3 class="line-clamp-2 text-sm leading-snug sm:line-clamp-1 font-semibold tracking-[-0.015em] text-primary">
			{tour.name}
		</h3>
		<p class="mt-0.5 flex flex-wrap items-center gap-x-2.5 gap-y-0.5 text-xs text-muted">
			{tour.facts.map((fact, index) => <span class:list={[index > 1 && 'max-sm:hidden', index === 0 && 'font-medium text-secondary']}>{fact}</span>)}
			{hasChips && (
				<>
					{tour.mostBookedPosition !== null && (
						<span class:list={[chip, 'bg-sun-soft text-sun-strong']}>
							<Star size={11} stroke-width={2} aria-hidden="true" />
							Más reservada {tour.mostBookedPosition}
						</span>
					)}
					{tour.pendingOnWeb && (
						<span class:list={[chip, 'bg-accent-soft text-accent-strong']}>
							<CircleDot size={11} stroke-width={2} aria-hidden="true" />
							Pendiente en la web
						</span>
					)}
					{missingCount > 0 && (
						<span class:list={[chip, 'bg-ink-300/50 text-secondary']}>
							Faltan {missingCount} {missingCount === 1 ? 'dato' : 'datos'}
						</span>
					)}
				</>
			)}
		</p>
	</div>

	<div class="hidden shrink-0 gap-1.5 group-data-[sorting]/panel:flex">
		<button type="button" class={arrowButton} data-move="up" aria-label={`Subir «${tour.shortName}»`} title="Subir">
			<ArrowUp size={15} stroke-width={1.75} aria-hidden="true" />
		</button>
		<button type="button" class={arrowButton} data-move="down" aria-label={`Bajar «${tour.shortName}»`} title="Bajar">
			<ArrowDown size={15} stroke-width={1.75} aria-hidden="true" />
		</button>
	</div>

	<div class="flex shrink-0 items-center gap-1.5 group-data-[sorting]/panel:hidden">
		{tour.status === 'active' && (
			<a
				href={tour.path}
				target="_blank"
				rel="noopener"
				class={glassCircle}
				aria-label={`Ver «${tour.shortName}» en la web`}
				title="Ver en la web"
			>
				<ExternalLink size={15} stroke-width={1.75} aria-hidden="true" />
			</a>
		)}
		<a href={`/manage/tours/${tour.id}`} class={glassCircle} aria-label={`Editar «${tour.shortName}»`} title="Editar">
			<Pencil size={15} stroke-width={1.75} aria-hidden="true" />
		</a>
	</div>
</li>
