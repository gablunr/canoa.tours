---
import { ArrowDown, ArrowUp, CircleDot, ExternalLink, ImageOff, Star } from '@lucide/astro';
import type { TourListItem } from './tour-list-data';
import { glassCircle } from '../glass-classes';

interface Props {
	tour: TourListItem;
}

const { tour } = Astro.props;
const { missingCount } = tour;

const chip = 'inline-flex h-5 items-center gap-1 rounded-full px-2 text-[11px] font-medium whitespace-nowrap';
const arrowButton = `${glassCircle} relative z-10 disabled:pointer-events-none disabled:opacity-40`;
const hasChips = tour.mostBookedPosition !== null || tour.pendingOnWeb || missingCount > 0;
---

<li
	class="group/row relative flex items-center gap-3 rounded-[1.125rem] p-1.5 pr-2 transition-colors duration-300 ease-smooth hover:bg-ink-200/60 has-[[data-tour-link]:focus-visible]:ring-2 has-[[data-tour-link]:focus-visible]:ring-accent sm:gap-3.5 sm:pr-2.5"
	data-tour-row
	data-tour-id={tour.id}
	data-search={tour.searchText}
>
	<span class="block aspect-[4/3] w-16 shrink-0 overflow-hidden rounded-[0.75rem] bg-ink-200/60 sm:w-20">
		{tour.imageUrl ? (
			<img src={tour.imageUrl} alt="" loading="lazy" decoding="async" width="80" height="60" class="size-full object-cover" />
		) : (
			<span class="flex size-full items-center justify-center text-muted">
				<ImageOff size={16} stroke-width={1.75} aria-hidden="true" />
			</span>
		)}
	</span>

	<div class="min-w-0 flex-1">
		<h3 class="line-clamp-2 text-sm leading-snug font-semibold tracking-[-0.015em] text-pretty text-primary sm:line-clamp-1 sm:text-[15px]">
			<a
				href={`/manage/tours/${tour.id}`}
				class="outline-none after:absolute after:inset-0 after:rounded-[1.125rem] group-data-[sorting]/panel:pointer-events-none"
				data-tour-link
			>
				{tour.name}
			</a>
		</h3>
		<p class="mt-0.5 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-muted">
			{tour.facts.map((fact, index) => <span class:list={[index > 0 && 'max-sm:hidden sm:inline', index === 0 && 'font-medium text-secondary']}>{fact}</span>)}
			{hasChips && (
				<>
					{tour.mostBookedPosition !== null && (
						<span class:list={[chip, 'bg-sun-soft text-sun-strong']}>
							<Star size={11} stroke-width={2} aria-hidden="true" />
							Más reservada {tour.mostBookedPosition}
						</span>
					)}
					{tour.pendingOnWeb && (
						<span class:list={[chip, 'bg-accent-soft text-accent-strong']}>
							<CircleDot size={11} stroke-width={2} aria-hidden="true" />
							Pendiente en la web
						</span>
					)}
					{missingCount > 0 && (
						<span class:list={[chip, 'bg-ink-300/50 text-secondary']}>
							Faltan {missingCount} {missingCount === 1 ? 'dato' : 'datos'}
						</span>
					)}
				</>
			)}
		</p>
		{tour.facts.length > 1 && <p class="mt-0.5 truncate text-xs text-muted sm:hidden">{tour.facts.slice(1).join(', ')}</p>}
	</div>

	<div class="hidden shrink-0 gap-1.5 group-data-[sorting]/panel:flex">
		<button type="button" class={arrowButton} data-move="up" aria-label={`Subir «${tour.shortName}»`} title="Subir">
			<ArrowUp size={15} stroke-width={1.75} aria-hidden="true" />
		</button>
		<button type="button" class={arrowButton} data-move="down" aria-label={`Bajar «${tour.shortName}»`} title="Bajar">
			<ArrowDown size={15} stroke-width={1.75} aria-hidden="true" />
		</button>
	</div>

	{tour.status === 'active' && (
		<span class="shrink-0 group-data-[sorting]/panel:hidden">
			<a
				href={tour.path}
				target="_blank"
				rel="noopener"
				class:list={[glassCircle, 'relative z-10']}
				aria-label={`Ver «${tour.shortName}» en la web`}
				title="Ver en la web"
			>
				<ExternalLink size={15} stroke-width={1.75} aria-hidden="true" />
			</a>
		</span>
	)}
</li>
