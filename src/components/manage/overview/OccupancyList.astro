---
import { ArrowUpRight } from '@lucide/astro';
import { glassChipButton } from '../glass-classes';
import type { OccupancyRow } from '../../../lib/manage/stats';
import { formatAxisDay } from '../../../lib/manage/charts';

interface Props {
	rows: OccupancyRow[];
	hiddenCount: number;
	note: string;
	delay?: number;
	class?: string;
}

const { rows, hiddenCount, note, delay = 0, class: className } = Astro.props;

const weekdayFormatter = new Intl.DateTimeFormat('es', { weekday: 'short', timeZone: 'UTC' });
const weekday = (isoDate: string) => weekdayFormatter.format(new Date(`${isoDate}T00:00:00Z`)).replace('.', '');
const fillPercent = (row: OccupancyRow) => (row.capacity > 0 ? Math.min(100, (row.seats_sold / row.capacity) * 100) : 0);
const stateLabel = (row: OccupancyRow) => {
	if (row.closed) return 'Cerrado';
	if (row.capacity > 0 && row.seats_sold >= row.capacity) return 'Completo';
	return null;
};
---

<section class:list={['animate-fade-up rounded-[1.75rem] bg-surface p-5 sm:p-6', className]} style={`animation-delay: ${delay}ms`} aria-labelledby="ocupacion-proxima">
	<div class="flex items-start justify-between gap-3">
		<div class="min-w-0">
			<h2 id="ocupacion-proxima" class="text-lg font-semibold tracking-[-0.03em] text-primary">Próximas salidas</h2>
			<p class="mt-0.5 text-xs text-muted">{note}</p>
		</div>
		<a
			href="/manage/departures"
			class:list={[glassChipButton, 'group shrink-0']}
		>
			Ver salidas
			<ArrowUpRight size={14} stroke-width={1.75} class="transition-transform duration-300 ease-smooth group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
		</a>
	</div>

	{rows.length === 0 ? (
		<p class="mt-4 text-sm text-muted">No hay plazas vendidas en los próximos 14 días.</p>
	) : (
		<ul class="mt-3 divide-y divide-border">
			{rows.map((row) => {
				const state = stateLabel(row);
				return (
					<li class="grid grid-cols-[3.5rem_minmax(0,1fr)] items-center gap-x-4 gap-y-2 py-2.5 sm:grid-cols-[4rem_minmax(0,1fr)_11rem]">
						<p class="text-xs leading-tight text-muted">
							<span class="block capitalize">{weekday(row.tour_date)}</span>
							<span class="block font-medium text-primary">{formatAxisDay(row.tour_date)}</span>
						</p>
						<p class="truncate text-sm font-medium text-primary">{row.product_name}</p>
						<div class="col-span-2 sm:col-span-1">
							<div class="flex items-baseline justify-between gap-2 text-xs">
								<span class="text-secondary tabular-nums">{row.seats_sold} de {row.capacity} plazas</span>
								{state && <span class="font-medium text-primary">{state}</span>}
							</div>
							<div
								class="mt-1.5 h-2 overflow-hidden rounded-full bg-teal-100"
								role="img"
								aria-label={`${row.seats_sold} de ${row.capacity} plazas vendidas${state ? `, ${state.toLowerCase()}` : ''}`}
							>
								<div class:list={['h-full rounded-full', row.closed ? 'bg-ink-300' : 'bg-teal-500']} style={`width: ${fillPercent(row)}%`}></div>
							</div>
						</div>
					</li>
				);
			})}
		</ul>
	)}

	{hiddenCount > 0 && (
		<p class="mt-3 text-xs text-muted">Y {hiddenCount} {hiddenCount === 1 ? 'salida más' : 'salidas más'} en los próximos 14 días.</p>
	)}
</section>
