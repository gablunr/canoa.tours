---
import { axisLabels, columnGeometry, fixedBarWidth, formatAxisDay, niceScale, type ChartPoint } from '../../../lib/manage/charts';

interface Props {
	id: string;
	summary: string;
	valueLabel: string;
	points: ChartPoint[];
	formatValue: (value: number) => string;
	class?: string;
}

const { id, summary, valueLabel, points, formatValue, class: className } = Astro.props;

const plotTop = 10;
const plotHeight = 140;
const axisSpace = 26;
const chartHeight = plotTop + plotHeight + axisSpace;
const baselineY = plotTop + plotHeight;

const scale = niceScale(Math.max(0, ...points.map((point) => point.value)));
const columns = columnGeometry(points, scale, plotTop, plotHeight);
const barWidth = fixedBarWidth(points.length);
const cornerRadius = barWidth ? Math.min(4, barWidth / 2) : 1;
const labels = axisLabels(columns);
const tickY = (tick: number) => plotTop + plotHeight - (tick / scale.top) * plotHeight;
const summaryId = `${id}-summary`;
const numberFormat = new Intl.NumberFormat('es');
---

<div class={className}>
	<p id={summaryId} class="text-sm text-secondary">{summary}</p>

	<div class="mt-5 flex gap-2">
		<div class="relative w-8 shrink-0 text-right text-[11px] text-muted tabular-nums" style={`height: ${chartHeight}px`} aria-hidden="true">
			{scale.ticks.map((tick) => (
				<span class="absolute right-0 -translate-y-1/2 leading-none" style={`top: ${tickY(tick)}px`}>{numberFormat.format(tick)}</span>
			))}
		</div>
		<svg
			class="block min-w-0 flex-1 overflow-visible"
			width="100%"
			height={chartHeight}
			role="img"
			aria-labelledby={summaryId}
		>
			{scale.ticks.map((tick) => (
				<line
					x1="0"
					x2="100%"
					y1={tickY(tick)}
					y2={tickY(tick)}
					class:list={[tick === 0 ? 'stroke-ink-300' : 'stroke-border']}
					stroke-width="1"
					shape-rendering="crispEdges"
				/>
			))}
			{columns.map((column) => (
				<g class="group">
					<title>{column.tooltip}</title>
					<rect x={`${column.slotStart}%`} y="0" width={`${column.slotWidth}%`} height={baselineY} class="fill-transparent transition-colors group-hover:fill-ink-200/45" />
					{column.barHeight > 0 && (
						barWidth ? (
							<g transform={`translate(${-barWidth / 2} 0)`}>
								<rect x={`${column.center}%`} y={column.barTop} width={barWidth} height={column.barHeight} rx={cornerRadius} class="fill-teal-500 transition-colors group-hover:fill-teal-700" />
								{column.barHeight > cornerRadius && (
									<rect x={`${column.center}%`} y={baselineY - cornerRadius} width={barWidth} height={cornerRadius} class="fill-teal-500 transition-colors group-hover:fill-teal-700" />
								)}
							</g>
						) : (
							<rect
								x={`${column.slotStart + column.slotWidth * 0.15}%`}
								y={column.barTop}
								width={`${column.slotWidth * 0.7}%`}
								height={column.barHeight}
								class="fill-teal-500 transition-colors group-hover:fill-teal-700"
							/>
						)
					)}
				</g>
			))}
			{labels.map((label) => (
				<text x={`${label.x}%`} y={chartHeight - 6} text-anchor={label.anchor} class="fill-muted text-[11px]">{label.text}</text>
			))}
		</svg>
	</div>

	<details class="mt-3 text-sm">
		<summary class="cursor-pointer text-[13px] font-medium text-secondary transition-colors hover:text-primary">Ver los datos</summary>
		<div class="mt-3 max-h-64 overflow-y-auto rounded-2xl bg-white/60">
			<table class="w-full text-sm">
				<thead>
					<tr class="text-left text-xs font-medium text-muted">
						<th scope="col" class="px-4 py-2 font-medium">Día</th>
						<th scope="col" class="px-4 py-2 text-right font-medium">{valueLabel}</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-border">
					{points.map((point) => (
						<tr>
							<td class="px-4 py-2 text-secondary">{formatAxisDay(point.date)}</td>
							<td class="px-4 py-2 text-right text-primary tabular-nums">{formatValue(point.value)}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</details>
</div>
