---
import { CircleAlert } from '@lucide/astro';
import { flatGlass, glassChipButton } from './glass-classes';
import { loadSiteStatus, type SiteState } from '../../lib/manage/site-status';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
const canRetry = Astro.locals.staffRole === 'admin' || Astro.locals.staffRole === 'editor';

let state: SiteState | null = null;
try {
	state = (await loadSiteStatus(Astro.locals.supabase)).state;
} catch (error) {
	console.error('site status failed', error);
}
---

{state && (
	<div
		class:list={[flatGlass, 'inline-flex h-10 items-center rounded-full bg-ink-200/45 pr-0.5 pl-3.5 text-xs font-medium whitespace-nowrap text-secondary sm:h-9 sm:text-[13px]', className]}
		data-site-status
		data-state={state}
	>
		<span role="status" class="flex items-center">
			<span class="flex items-center gap-2 pr-3" data-site-status-view="live" hidden={state !== 'live'}>
				<span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
				La web está al día
			</span>
			<span class="flex items-center gap-2 pr-3" data-site-status-view="updating" hidden={state !== 'updating'}>
				<span class="size-3 rounded-full border-[1.5px] border-current border-t-transparent opacity-60 motion-safe:animate-spin" aria-hidden="true"></span>
				Actualizando la web…
			</span>
			<span class:list={['flex items-center gap-2', canRetry ? 'pr-2' : 'pr-3']} data-site-status-view="stale" hidden={state !== 'stale'}>
				<CircleAlert size={14} stroke-width={2} class="text-sun-strong" aria-hidden="true" />
				La web no se actualizó
			</span>
		</span>
		{canRetry && (
			<button type="button" class={glassChipButton} hidden={state !== 'stale'} data-site-status-retry>
				Reintentar
			</button>
		)}
	</div>
)}

<script>
	import { initSiteStatus } from '../../scripts/manage/site-status';

	document.querySelectorAll<HTMLElement>('[data-site-status]').forEach(initSiteStatus);
</script>
