---
import { glassOption } from '../glass-classes';
import { fieldError, fieldHint } from './field-classes';

interface Props {
	name?: string;
	label?: string;
	selected?: readonly number[];
	hint?: string;
	requiredMessage?: string;
}

const { name = 'weekdays', label = 'Días', selected = [], hint, requiredMessage } = Astro.props;

const weekdays = [
	{ value: 1, short: 'L', long: 'Lunes' },
	{ value: 2, short: 'M', long: 'Martes' },
	{ value: 3, short: 'X', long: 'Miércoles' },
	{ value: 4, short: 'J', long: 'Jueves' },
	{ value: 5, short: 'V', long: 'Viernes' },
	{ value: 6, short: 'S', long: 'Sábado' },
	{ value: 7, short: 'D', long: 'Domingo' },
];

const pickerId = `field-${name}`;
const hintId = `${pickerId}-hint`;
const errorId = `${pickerId}-error`;
const describedBy = hint ? `${hintId} ${errorId}` : errorId;
const selectedDays = new Set(selected);
const allSelected = weekdays.every((day) => selectedDays.has(day.value));

const dayChip =
	'liquid-glass flex size-10 cursor-pointer items-center justify-center bg-ink-200/60 text-[13px] font-medium text-secondary transition-colors duration-300 ease-smooth [--glass-drop-shadow:0_0_#0000] hover:bg-ink-200/90 hover:text-primary has-[:checked]:bg-primary/90 has-[:checked]:text-white has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-accent sm:size-9';
---

<fieldset
	id={pickerId}
	class="min-w-0 scroll-mt-24"
	aria-describedby={describedBy}
	data-field
	data-required-message={requiredMessage}
	data-weekday-picker
>
	<legend class="text-[13px] font-medium text-primary">{label}</legend>
	{hint && <p id={hintId} class={fieldHint}>{hint}</p>}
	<div class="mt-3 flex flex-wrap items-center gap-1.5">
		{weekdays.map((day) => (
			<label class={dayChip} title={day.long}>
				<input
					type="checkbox"
					id={`${pickerId}-${day.value}`}
					name={name}
					value={day.value}
					checked={selectedDays.has(day.value)}
					data-weekday
					class="sr-only"
				/>
				<span aria-hidden="true">{day.short}</span>
				<span class="sr-only">{day.long}</span>
			</label>
		))}
		<button type="button" data-weekday-all aria-pressed={allSelected ? 'true' : 'false'} class:list={[glassOption, 'ml-1']}>
			Todos los días
		</button>
	</div>
	<p id={errorId} data-field-error class={fieldError} hidden></p>
</fieldset>

<script>
	import { initWeekdayPickers } from '../../../scripts/manage/weekday-picker';

	initWeekdayPickers(document);
</script>
