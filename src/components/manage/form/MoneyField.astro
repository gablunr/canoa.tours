---
import type { HTMLAttributes } from 'astro/types';
import { fieldError, fieldHint, fieldInput, fieldLabel, fieldOptional } from './field-classes';

interface Props extends Omit<HTMLAttributes<'input'>, 'id' | 'class' | 'name' | 'type' | 'value' | 'inputmode' | 'step'> {
	label: string;
	name: string;
	value?: number | string | null;
	hint?: string;
	requiredMessage?: string;
	invalidMessage?: string;
}

const { label, name, value, hint, requiredMessage, invalidMessage, required, min = 0, ...attributes } = Astro.props;

const inputId = `field-${name}`;
const prefixId = `${inputId}-currency`;
const hintId = `${inputId}-hint`;
const errorId = `${inputId}-error`;
const describedBy = [prefixId, hint && hintId, errorId].filter(Boolean).join(' ');
---

<div data-field data-required-message={requiredMessage} data-invalid-message={invalidMessage}>
	<label for={inputId} class={fieldLabel}>
		{label}
		{!required && <span class={fieldOptional}>Opcional</span>}
	</label>
	<div class="relative mt-1.5">
		<span id={prefixId} class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-base text-muted sm:text-sm">US$</span>
		<input
			{...attributes}
			id={inputId}
			name={name}
			type="number"
			inputmode="decimal"
			step="0.01"
			min={min}
			value={value ?? undefined}
			required={required}
			aria-describedby={describedBy}
			class:list={[fieldInput, 'pl-12 tabular-nums']}
		/>
	</div>
	{hint && <p id={hintId} class={fieldHint}>{hint}</p>}
	<p id={errorId} data-field-error class={fieldError} hidden></p>
</div>
