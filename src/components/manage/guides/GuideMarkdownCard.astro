---
import { Bold, Braces, CircleQuestionMark, Heading2, Link, List, MessageCircleQuestionMark, Table2 } from '@lucide/astro';
import { contentTokens } from '../../../data/guides/content-tokens';
import { glassChipButton, surfacePanel } from '../glass-classes';

interface Props {
	title: string;
	markdown: string;
}

const { title, markdown } = Astro.props;

const tools = [
	{ action: 'section', label: 'Sección', shortcut: '', icon: Heading2 },
	{ action: 'bold', label: 'Negrita', shortcut: ' (Ctrl+B)', icon: Bold },
	{ action: 'link', label: 'Enlace', shortcut: ' (Ctrl+K)', icon: Link },
	{ action: 'list', label: 'Lista', shortcut: '', icon: List },
	{ action: 'table', label: 'Tabla', shortcut: '', icon: Table2 },
	{ action: 'question', label: 'Pregunta', shortcut: '', icon: MessageCircleQuestionMark },
];

const markers = Object.entries(contentTokens).map(([name, value]) => ({ name, value }));

const placeholder = [
	'Empieza con lo esencial en dos o tres frases.',
	'',
	'## Primera sección',
	'',
	'Texto de la sección.',
	'',
	'- Un punto de la lista',
	'- Otro punto',
	'',
	'## Preguntas frecuentes',
	'',
	'### ¿Una pregunta?',
	'',
	'Su respuesta.',
].join('\n');

const syntax = [
	{ code: 'Primer párrafo', text: 'Lo esencial. Sale destacado arriba del todo.' },
	{ code: '## Título', text: 'Empieza una sección.' },
	{ code: '- Elemento', text: 'Un punto de una lista.' },
	{ code: '**texto**', text: 'Negrita.' },
	{ code: '[texto](/isla-saona)', text: 'Un enlace.' },
	{ code: '| A | B |', text: 'Una tabla. La primera fila es la cabecera.' },
	{ code: '### ¿Pregunta?', text: 'Una pregunta, dentro de ## Preguntas frecuentes.' },
	{ code: '{{insurancePrice}}', text: 'Un dato de la web que se actualiza solo.' },
];

const toolButton = [glassChipButton, 'shrink-0 max-sm:size-9 max-sm:px-0'];
const centeredColumn = 'px-[max(1rem,calc((100%-46rem)/2))]';
const codeClass = 'rounded-md bg-ink-100 px-1.5 py-0.5 font-mono text-[12px] whitespace-nowrap text-primary';
---

<section
	aria-label="Editor de la guía"
	class:list={[surfacePanel, 'relative flex h-[calc(100dvh-5.5rem)] min-h-[26rem] animate-fade-up flex-col p-1.5 sm:h-[calc(100dvh-6.5rem)] sm:min-h-[32rem]']}
	style="animation-delay: 120ms"
	data-markdown-card
>
	<div class="flex items-center gap-1.5 overflow-x-auto p-1 [scrollbar-width:none]" role="toolbar" aria-label="Formato del texto">
		{tools.map((tool) => (
			<button type="button" class:list={toolButton} title={`${tool.label}${tool.shortcut}`} data-markdown-tool={tool.action}>
				<tool.icon size={15} stroke-width={1.75} aria-hidden="true" />
				<span class="max-sm:sr-only">{tool.label}</span>
			</button>
		))}
		<label class:list={[...toolButton, 'relative has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-accent']} title="Insertar un dato de la web">
			<Braces size={15} stroke-width={1.75} aria-hidden="true" />
			<span class="max-sm:sr-only">Dato</span>
			<select class="absolute inset-0 cursor-pointer opacity-0" aria-label="Insertar un dato de la web" data-marker-select>
				<option value="">Insertar un dato de la web</option>
				{markers.map((marker) => (
					<option value={marker.name}>{`${marker.value} ({{${marker.name}}})`}</option>
				))}
			</select>
		</label>
		<button type="button" class:list={[...toolButton, 'ml-auto']} aria-expanded="false" aria-controls="guia-ayuda" title="Cómo se escribe" data-help-toggle>
			<CircleQuestionMark size={15} stroke-width={1.75} aria-hidden="true" />
			<span class="max-sm:sr-only">Ayuda</span>
		</button>
	</div>

	<div
		id="guia-ayuda"
		class="absolute inset-x-2 top-14 z-20 max-h-[min(26rem,75%)] overflow-y-auto overscroll-contain rounded-[1.25rem] border border-border bg-background p-4 sm:left-auto sm:w-[26rem]"
		hidden
		data-help-panel
	>
		<p class="mb-3 text-sm font-semibold text-primary">Cómo se escribe</p>
		<dl class="grid gap-x-5 gap-y-2 text-sm sm:grid-cols-[auto_minmax(0,1fr)]">
			{syntax.map((item) => (
				<div class="grid gap-1 sm:contents">
					<dt><code class={codeClass}>{item.code}</code></dt>
					<dd class="text-secondary">{item.text}</dd>
				</div>
			))}
		</dl>
	</div>

	<div class="mt-1 flex min-h-0 flex-1 flex-col overflow-hidden rounded-[1.4rem] border border-border bg-background">
		<label for="field-title" class="sr-only">Título</label>
		<textarea
			id="field-title"
			name="title"
			rows="1"
			required
			minlength="5"
			maxlength="120"
			placeholder="Añade un título"
			class:list={[
				centeredColumn,
				'block max-h-40 w-full shrink-0 resize-none border-b border-border bg-transparent pt-6 pb-4 text-2xl leading-[1.15] font-semibold tracking-[-0.035em] text-primary outline-none field-sizing-content placeholder:text-subtle sm:pt-8 sm:pb-5 sm:text-[2rem]',
			]}
			data-title-input
		>{title}</textarea>

		<label for="field-body" class="sr-only">Texto de la guía</label>
		<textarea
			id="field-body"
			name="body"
			spellcheck="true"
			placeholder={placeholder}
			class:list={[centeredColumn, 'block min-h-0 w-full flex-1 resize-none overflow-y-auto bg-transparent py-5 text-base leading-[1.75] text-primary outline-none placeholder:text-subtle sm:text-[15px]']}
			data-markdown-input
		>{markdown}</textarea>

		<div class="max-h-36 shrink-0 overflow-y-auto border-t border-[#f3c7c2] bg-[#fbe9e7] px-4 py-3 text-sm text-error" role="alert" data-markdown-issues hidden>
			<p class="font-medium">Revisa esto antes de guardar</p>
			<ul class="mt-1 grid gap-0.5" data-markdown-issue-list></ul>
		</div>

		<p class="flex shrink-0 items-center justify-between gap-3 border-t border-border px-4 py-2.5 text-xs text-muted">
			<span><output class="tabular-nums" data-word-count>0</output> palabras</span>
			<span><output class="tabular-nums" data-reading-minutes>1</output> min de lectura</span>
		</p>
	</div>
</section>
