---
import { ExternalLink, ImageOff, Pencil, Star } from '@lucide/astro';
import type { GuideListItem } from './guide-data';
import { glassCircle, glassPanel } from '../glass-classes';

interface Props {
	guides: GuideListItem[];
}

const { guides } = Astro.props;

const timeZone = 'America/Santo_Domingo';
const dayKey = new Intl.DateTimeFormat('en-CA', { timeZone });
const shortDate = new Intl.DateTimeFormat('es', { day: 'numeric', month: 'short', timeZone });
const dayNumber = (date: Date) => Date.parse(dayKey.format(date)) / 86_400_000;
const today = dayNumber(new Date());

function whenLabel(isoDate: string) {
	const date = new Date(isoDate);
	const daysAgo = Math.round(today - dayNumber(date));
	if (daysAgo <= 0) return 'hoy';
	if (daysAgo === 1) return 'ayer';
	if (daysAgo < 7) return `hace ${daysAgo} días`;
	return `el ${shortDate.format(date).replace('.', '')}`;
}

const activityLabel = (guide: GuideListItem) =>
	guide.status === 'published' ? `Publicada ${whenLabel(guide.publishedAt ?? guide.updatedAt)}` : `Editada ${whenLabel(guide.updatedAt)}`;

const chip = 'inline-flex h-6 items-center gap-1 rounded-full px-2.5 text-xs font-medium whitespace-nowrap';
---

<ul aria-label="Guías" class="grid gap-2.5 sm:gap-3">
	{guides.map((guide, index) => (
		<li
			class:list={[
				glassPanel,
				'group relative flex animate-fade-up items-center gap-3.5 rounded-[1.5rem] p-2.5 pr-3 transition-colors duration-300 ease-smooth hover:bg-ink-200/60 has-[[data-guide-link]:focus-visible]:ring-2 has-[[data-guide-link]:focus-visible]:ring-accent sm:gap-5 sm:p-3 sm:pr-4',
			]}
			style={`animation-delay: ${140 + Math.min(index, 8) * 40}ms`}
		>
			<span class="block aspect-[4/3] w-24 shrink-0 overflow-hidden rounded-[1.125rem] bg-ink-200/60 sm:w-32">
				{guide.imageUrl ? (
					<img src={guide.imageUrl} alt="" loading="lazy" decoding="async" width="128" height="96" class="size-full object-cover" />
				) : (
					<span class="flex size-full items-center justify-center text-muted">
						<ImageOff size={18} stroke-width={1.75} aria-hidden="true" />
					</span>
				)}
			</span>

			<div class="min-w-0 flex-1">
				<div class="flex flex-wrap items-center gap-1.5">
					<span class:list={[chip, 'bg-white/75 text-secondary']}>{guide.siloLabel}</span>
					{guide.featured && (
						<span class:list={[chip, 'bg-sun-soft text-sun-strong']}>
							<Star size={12} stroke-width={2} aria-hidden="true" />
							Destacada
						</span>
					)}
				</div>
				<h2 class="mt-1.5 line-clamp-2 text-[15px] leading-snug font-semibold tracking-[-0.02em] text-pretty text-primary sm:text-base">
					<a href={`/manage/guides/${guide.id}`} class="outline-none after:absolute after:inset-0 after:rounded-[1.5rem]" data-guide-link>
						{guide.title}
					</a>
				</h2>
				<p class="mt-1 text-xs text-muted">
					{activityLabel(guide)}
					{guide.readingMinutes && <span class="max-sm:hidden">, {guide.readingMinutes} min de lectura</span>}
				</p>
			</div>

			{guide.status === 'published' && (
				<a
					href={guide.path}
					target="_blank"
					rel="noopener"
					class:list={[glassCircle, 'relative z-10 shrink-0 max-sm:hidden']}
					aria-label={`Ver «${guide.title}» en la web`}
					title="Ver en la web"
				>
					<ExternalLink size={15} stroke-width={1.75} aria-hidden="true" />
				</a>
			)}
			<a
				href={`/manage/guides/${guide.id}`}
				class:list={[glassCircle, 'relative z-10 shrink-0 group-hover:bg-ink-200/90 group-hover:text-primary']}
				aria-label={`Editar «${guide.title}»`}
				title="Editar"
			>
				<Pencil size={15} stroke-width={1.75} aria-hidden="true" />
			</a>
		</li>
	))}
</ul>
