---
import Button from '../../ui/Button.astro';
import RoleSelect from './RoleSelect.astro';
import type { TeamMember } from './team-data';

interface Props {
	members: TeamMember[];
}

const { members } = Astro.props;
const youBadge = 'inline-flex h-6 shrink-0 items-center rounded-full bg-accent-soft px-2.5 text-xs font-medium text-accent-strong';
---

<section aria-label="Miembros del equipo" class="animate-fade-up rounded-[2rem] bg-surface p-6 sm:p-8" style="animation-delay: 120ms">
	<ul class="divide-y divide-border md:hidden">
		{members.map((member) => (
			<li class="py-4 first:pt-0 last:pb-0">
				<div class="flex items-center gap-2">
					<p class="min-w-0 truncate font-medium text-primary">{member.email}</p>
					{member.isCurrentUser && <span class={youBadge}>Tú</span>}
				</div>
				<p class="mt-1 text-xs text-muted">Último acceso: {member.lastSignInLabel}</p>
				<div class="mt-3 flex flex-wrap items-center justify-between gap-3">
					<RoleSelect member={member} />
					{!member.isCurrentUser && (
						<Button variant="outline" size="sm" data-member-remove data-user-id={member.userId} data-email={member.email}>Quitar</Button>
					)}
				</div>
			</li>
		))}
	</ul>

	<table class="hidden w-full text-sm md:table">
		<thead>
			<tr class="text-left text-xs font-medium text-muted">
				<th scope="col" class="pb-3 font-medium">Miembro</th>
				<th scope="col" class="pb-3 font-medium">Rol</th>
				<th scope="col" class="pb-3 font-medium">Último acceso</th>
				<th scope="col" class="pb-3 font-medium"><span class="sr-only">Acciones</span></th>
			</tr>
		</thead>
		<tbody class="divide-y divide-border border-t border-border">
			{members.map((member) => (
				<tr>
					<td class="py-4 pr-4 align-middle">
						<div class="flex items-center gap-2">
							<span class="min-w-0 truncate font-medium text-primary">{member.email}</span>
							{member.isCurrentUser && <span class={youBadge}>Tú</span>}
						</div>
					</td>
					<td class="py-4 pr-4 align-middle">
						<RoleSelect member={member} />
					</td>
					<td class="py-4 pr-4 align-middle text-secondary">{member.lastSignInLabel}</td>
					<td class="py-4 text-right align-middle">
						{!member.isCurrentUser && (
							<Button variant="outline" size="sm" data-member-remove data-user-id={member.userId} data-email={member.email}>Quitar</Button>
						)}
					</td>
				</tr>
			))}
		</tbody>
	</table>

	<p class="mt-4 text-sm text-error" role="alert" data-team-error hidden></p>
</section>
