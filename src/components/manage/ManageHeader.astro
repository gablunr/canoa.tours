---
import { Image } from 'astro:assets';
import { ArrowUpRight, BookOpenText, CalendarDays, CalendarRange, ChartNoAxesColumn, ChevronDown, ListChecks, LogOut, MessageSquareText, TicketPercent, UsersRound } from '@lucide/astro';
import logo from '../../assets/images/brand/logo-dark.svg';
import { company } from '../../data/site/company';
import { manageSections, menuForRole, panelHomeHref, type ManageSectionId } from '../../data/manage/sections';

interface Props {
	current: ManageSectionId;
}

const { current } = Astro.props;
const { links, groups } = menuForRole(Astro.locals.staffRole);
const email = Astro.locals.user?.email ?? '';
const currentGroup = manageSections.find((section) => section.id === current)?.group ?? null;

const sectionIcons: Record<ManageSectionId, typeof ListChecks> = {
	overview: ChartNoAxesColumn,
	bookings: ListChecks,
	departures: CalendarDays,
	capacity: CalendarRange,
	reviews: MessageSquareText,
	guides: BookOpenText,
	coupons: TicketPercent,
	team: UsersRound,
};

const topLink =
	'block rounded-full px-3.5 py-2 text-muted-on-dark outline-none transition-colors duration-300 ease-smooth hover:text-white focus-visible:ring-2 focus-visible:ring-accent-on-dark aria-[current=page]:bg-white/10 aria-[current=page]:text-white';
const trigger =
	'group/trigger flex cursor-pointer items-center gap-1 rounded-full py-2 pr-2.5 pl-3.5 text-muted-on-dark outline-none transition-colors duration-300 ease-smooth hover:text-white focus-visible:ring-2 focus-visible:ring-accent-on-dark aria-expanded:bg-white/10 aria-expanded:text-white data-current:text-white';
const tile =
	'group relative flex h-full min-h-32 flex-col bento-glass rounded-2xl p-5 outline-none transition-colors duration-300 ease-smooth hover:bg-white/10 focus-visible:ring-2 focus-visible:ring-accent-on-dark aria-[current=page]:bg-white/10';
const corner =
	'absolute top-4 right-4 text-white/40 transition duration-300 ease-smooth group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-white';
const mobileRow =
	'flex items-center gap-3 rounded-xl px-3 py-2.5 outline-none transition-colors duration-300 ease-smooth hover:bg-white/5 focus-visible:ring-2 focus-visible:ring-accent-on-dark aria-[current=page]:bg-white/10';
const accordion =
	'group/section details-content:h-0 details-content:overflow-y-clip details-content:opacity-0 details-content:transition-[height,opacity,content-visibility] details-content:transition-discrete details-content:duration-500 details-content:ease-smooth [interpolate-size:allow-keywords] open:details-content:h-auto open:details-content:opacity-100';
const accordionSummary =
	'flex cursor-pointer list-none items-center justify-between rounded-xl px-3 py-3 text-[15px] text-muted-on-dark outline-none transition-colors duration-300 ease-smooth group-open/section:text-white hover:text-white focus-visible:ring-2 focus-visible:ring-accent-on-dark [&::-webkit-details-marker]:hidden';
const signOutButton =
	'flex cursor-pointer items-center gap-2 rounded-full bg-white/10 text-[13px] font-medium text-white outline-none transition-colors duration-300 ease-smooth hover:bg-white/20 focus-visible:ring-2 focus-visible:ring-accent-on-dark';
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50 flex justify-center px-3" data-manage-header>
	<div
		data-mega-backdrop
		class="pointer-events-none fixed inset-0 bg-primary/15 opacity-0 backdrop-blur-[2px] transition-opacity duration-500 ease-smooth data-open:pointer-events-auto data-open:opacity-100 max-lg:hidden"
		aria-hidden="true"
	>
	</div>
	<div
		data-entrance
		data-notch
		class="notch notch-ears pointer-events-auto relative w-full max-w-md animate-notch-drop rounded-b-[1.375rem] bg-notch text-white transition-[width,max-width,border-radius] duration-500 ease-smooth [--mega-width:min(48rem,calc(100vw-1.5rem))] md:max-lg:data-menu-open:max-w-2xl lg:w-auto lg:max-w-none lg:data-mega-open:rounded-b-[2rem]"
	>
		<nav class="flex h-14 items-center gap-3 pr-2 pl-4 sm:pl-5 lg:gap-6 lg:pl-6" aria-label="Panel del equipo">
			<a href={panelHomeHref(Astro.locals.staffRole)} class="mr-auto flex shrink-0 items-center transition-opacity duration-300 ease-smooth hover:opacity-75">
				<Image src={logo} alt={company.brandName} loading="eager" class="h-6 w-auto" />
			</a>

			<ul class="hidden items-center gap-1 text-[13px] whitespace-nowrap lg:mr-auto lg:flex">
				{links.map((section) => (
					<li>
						<a href={section.href} aria-current={section.id === current ? 'page' : undefined} class={topLink}>
							{section.label}
						</a>
					</li>
				))}
				{groups.map((group) => (
					<li>
						<button
							type="button"
							class={trigger}
							aria-expanded="false"
							aria-controls={`manage-mega-${group.id}`}
							data-mega-trigger={group.id}
							data-current={group.id === currentGroup ? '' : undefined}
						>
							{group.label}
							<ChevronDown size={14} class="transition-transform duration-500 ease-smooth group-aria-expanded/trigger:rotate-180" aria-hidden="true" />
						</button>
					</li>
				))}
			</ul>

			<form method="post" action="/api/auth/sign-out" class="hidden lg:block">
				<button type="submit" title={email ? `Cerrar la sesión de ${email}` : undefined} class:list={[signOutButton, 'h-10 px-4']}>
					<LogOut size={15} stroke-width={1.75} aria-hidden="true" />
					Cerrar sesión
				</button>
			</form>

			<button
				type="button"
				class="group/burger relative flex size-10 items-center justify-center text-white lg:hidden"
				aria-label="Abrir menú"
				aria-expanded="false"
				aria-controls="manage-menu"
				data-menu-toggle
			>
				<span class="absolute h-[1.5px] w-4 -translate-y-[4px] rounded-full bg-current transition duration-500 ease-smooth group-aria-expanded/burger:translate-y-0 group-aria-expanded/burger:rotate-45"></span>
				<span class="absolute h-[1.5px] w-4 translate-y-[4px] rounded-full bg-current transition duration-500 ease-smooth group-aria-expanded/burger:translate-y-0 group-aria-expanded/burger:-rotate-45"></span>
			</button>
		</nav>

		<div data-mega inert class="h-0 w-0 min-w-full overflow-hidden transition-[height] duration-500 ease-smooth max-lg:hidden">
			<div class="flex justify-center">
				<div data-mega-content class="relative w-(--mega-width) shrink-0 px-5 pt-3 pb-6">
					{groups.map((group) => (
						<section
							id={`manage-mega-${group.id}`}
							aria-label={group.label}
							inert
							data-mega-panel={group.id}
							class="invisible absolute inset-x-5 top-3 translate-y-1 opacity-0 transition-[opacity,translate,visibility] duration-150 ease-smooth data-active:visible data-active:delay-100 data-active:duration-300 data-active:static data-active:translate-y-0 data-active:opacity-100"
						>
							<ul class="grid grid-cols-3 gap-2">
								{group.sections.map((section) => {
									const Icon = sectionIcons[section.id];
									return (
										<li>
											<a href={section.href} aria-current={section.id === current ? 'page' : undefined} class={tile}>
												<ArrowUpRight size={18} class={corner} aria-hidden="true" />
												<Icon size={20} stroke-width={1.75} class="mb-auto text-accent-on-dark" aria-hidden="true" />
												<span class="mt-6 text-base leading-tight font-semibold tracking-[-0.02em]">{section.label}</span>
												<span class="mt-1 text-[13px] leading-relaxed text-muted-on-dark">{section.description}</span>
											</a>
										</li>
									);
								})}
							</ul>
						</section>
					))}
				</div>
			</div>
		</div>

		<div id="manage-menu" inert data-notch-menu class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-smooth data-open:grid-rows-[1fr] lg:hidden">
			<div class="overflow-hidden">
				<div class="max-h-[calc(100dvh-4.5rem)] overflow-y-auto overscroll-contain px-3 pb-4 [scrollbar-width:none]">
					{links.length > 0 && (
						<ul class="grid gap-1 pb-1">
							{links.map((section) => {
								const Icon = sectionIcons[section.id];
								return (
									<li>
										<a href={section.href} aria-current={section.id === current ? 'page' : undefined} class={mobileRow}>
											<Icon size={18} stroke-width={1.75} class="shrink-0 text-accent-on-dark" aria-hidden="true" />
											<span class="min-w-0">
												<span class="block text-[15px] leading-tight">{section.label}</span>
												<span class="block truncate text-xs text-muted-on-dark">{section.description}</span>
											</span>
										</a>
									</li>
								);
							})}
						</ul>
					)}
					{groups.map((group) => (
						<details name="manage-menu-section" open={group.id === currentGroup} class={accordion}>
							<summary class={accordionSummary}>
								{group.label}
								<ChevronDown size={18} class="transition-transform duration-500 ease-smooth group-open/section:rotate-180" aria-hidden="true" />
							</summary>
							<ul class="grid gap-1 pb-2">
								{group.sections.map((section) => {
									const Icon = sectionIcons[section.id];
									return (
										<li>
											<a href={section.href} aria-current={section.id === current ? 'page' : undefined} class={mobileRow}>
												<Icon size={18} stroke-width={1.75} class="shrink-0 text-accent-on-dark" aria-hidden="true" />
												<span class="min-w-0">
													<span class="block text-[15px] leading-tight">{section.label}</span>
													<span class="block truncate text-xs text-muted-on-dark">{section.description}</span>
												</span>
											</a>
										</li>
									);
								})}
							</ul>
						</details>
					))}
					<div class="mt-3 flex items-center justify-between gap-3 border-t border-white/10 px-3 pt-4">
						{email && <p class="min-w-0 truncate text-xs text-muted-on-dark">{email}</p>}
						<form method="post" action="/api/auth/sign-out" class="shrink-0">
							<button type="submit" class:list={[signOutButton, 'h-9 px-4']}>
								<LogOut size={15} stroke-width={1.75} aria-hidden="true" />
								Cerrar sesión
							</button>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
</header>

<script>
	import { initNotchNavigation } from '../../scripts/ui/notch-navigation';

	document.querySelectorAll<HTMLElement>('[data-manage-header]').forEach(initNotchNavigation);
</script>
