---
import { Image } from 'astro:assets';
import logo from '../../assets/images/brand/logo-dark.svg';
import { company } from '../../data/site/company';
import { ChevronDown } from '@lucide/astro';
import ArrowButton from '../ui/ArrowButton.astro';
import AccountPanel from './mega-menu/AccountPanel.astro';
import BookingHelpPanel from './mega-menu/BookingHelpPanel.astro';
import ExcursionsPanel from './mega-menu/ExcursionsPanel.astro';
import GuidesPanel from './mega-menu/GuidesPanel.astro';
import MobileMenu from './mega-menu/MobileMenu.astro';
import { catalogLink, reviewsLink } from '../../data/site/navigation';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => currentPath === href;

const megaMenus = [
	{ id: 'excursiones', label: 'Excursiones', Panel: ExcursionsPanel },
	{ id: 'antes-de-reservar', label: 'Antes de reservar', Panel: BookingHelpPanel },
	{ id: 'guias', label: 'Guías', Panel: GuidesPanel },
];

const accountMenu = { id: 'cuenta', label: 'Mi cuenta', Panel: AccountPanel };
const panelMenus = [...megaMenus, accountMenu];

const navItems = [
	...megaMenus.map((menu) => ({ kind: 'mega' as const, ...menu })),
	{ kind: 'link' as const, ...reviewsLink },
	{ kind: 'mega' as const, ...accountMenu },
];
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50 flex justify-center px-3" data-site-header>
	<div
		data-mega-backdrop
		class="pointer-events-none fixed inset-0 bg-primary/15 opacity-0 backdrop-blur-[2px] transition-opacity duration-500 ease-smooth data-open:pointer-events-auto data-open:opacity-100 max-lg:hidden"
		aria-hidden="true"
	>
	</div>
	<div
		data-entrance
		data-notch
		class="notch notch-ears pointer-events-auto relative w-full max-w-md animate-notch-drop rounded-b-[1.375rem] bg-notch text-white transition-[width,max-width,border-radius] duration-500 ease-smooth [--mega-width:min(68rem,calc(100vw-1.5rem))] md:max-lg:data-menu-open:max-w-2xl lg:w-auto lg:max-w-none lg:data-mega-open:rounded-b-[2rem]"
	>
		<nav class="flex h-14 items-center gap-3 pr-2 pl-4 sm:pl-5 lg:gap-8 lg:pr-2 lg:pl-6" aria-label="Principal">
			<a href="/" class="mr-auto flex shrink-0 items-center transition-opacity duration-300 ease-smooth hover:opacity-75">
				<Image src={logo} alt={company.brandName} loading="eager" class="h-6 w-auto" />
			</a>

			<ul class="hidden items-center gap-1 text-[13px] whitespace-nowrap lg:mr-auto lg:flex">
				{navItems.map((item) => (
					<li>
						{item.kind === 'mega' ? (
							<button
								type="button"
								class="group/trigger flex cursor-pointer items-center gap-1 rounded-full py-2 pr-2.5 pl-3.5 text-muted-on-dark outline-none transition-colors duration-300 ease-smooth hover:text-white focus-visible:ring-2 focus-visible:ring-accent-on-dark aria-expanded:bg-white/10 aria-expanded:text-white"
								aria-expanded="false"
								aria-controls={`mega-${item.id}`}
								data-mega-trigger={item.id}
							>
								{item.label}
								<ChevronDown size={14} class="transition-transform duration-500 ease-smooth group-aria-expanded/trigger:rotate-180" aria-hidden="true" />
							</button>
						) : (
							<a
								href={item.href}
								aria-current={isCurrent(item.href) ? 'page' : undefined}
								class="block rounded-full px-3.5 py-2 text-muted-on-dark transition-colors duration-300 ease-smooth hover:text-white aria-[current=page]:text-white"
							>
								{item.label}
							</a>
						)}
					</li>
				))}
			</ul>

			<ArrowButton href={catalogLink.href} size="sm" class="shrink-0 focus-visible:ring-offset-notch max-lg:hidden">
				{catalogLink.label}
			</ArrowButton>

			<button
				type="button"
				class="group/burger relative flex size-10 items-center justify-center text-white lg:hidden"
				aria-label="Abrir menú"
				aria-expanded="false"
				aria-controls="notch-menu"
				data-menu-toggle
			>
				<span class="absolute h-[1.5px] w-4 -translate-y-[4px] rounded-full bg-current transition duration-500 ease-smooth group-aria-expanded/burger:translate-y-0 group-aria-expanded/burger:rotate-45"></span>
				<span class="absolute h-[1.5px] w-4 translate-y-[4px] rounded-full bg-current transition duration-500 ease-smooth group-aria-expanded/burger:translate-y-0 group-aria-expanded/burger:-rotate-45"></span>
			</button>
		</nav>

		<div data-mega inert class="h-0 w-0 min-w-full overflow-hidden transition-[height] duration-500 ease-smooth max-lg:hidden">
			<div class="flex justify-center">
				<div data-mega-content class="relative w-(--mega-width) shrink-0 px-5 pt-3 pb-6">
					{panelMenus.map(({ id, label, Panel }) => (
						<section
							id={`mega-${id}`}
							aria-label={label}
							inert
							data-mega-panel={id}
							class="invisible absolute inset-x-5 top-3 translate-y-1 opacity-0 transition-[opacity,translate,visibility] duration-150 ease-smooth data-active:visible data-active:delay-100 data-active:duration-300 data-active:static data-active:translate-y-0 data-active:opacity-100"
						>
							<Panel />
						</section>
					))}
				</div>
			</div>
		</div>

		<div id="notch-menu" inert data-notch-menu class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-smooth data-open:grid-rows-[1fr] lg:hidden">
			<div class="overflow-hidden">
				<div class="max-h-[calc(100dvh-4.5rem)] overflow-y-auto overscroll-contain px-3 pb-4 [scrollbar-width:none]">
					<MobileMenu currentPath={currentPath} />
					<ArrowButton href={catalogLink.href} class="mt-3 w-full focus-visible:ring-offset-notch">
						{catalogLink.label}
					</ArrowButton>
				</div>
			</div>
		</div>
	</div>
</header>

<script>
	import { initAccountMenus } from '../../scripts/ui/account-menu';
	import { initNotchNavigation } from '../../scripts/ui/notch-navigation';

	document.querySelectorAll<HTMLElement>('[data-site-header]').forEach(initNotchNavigation);
	initAccountMenus();
</script>
