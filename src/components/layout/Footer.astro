---
import { Image } from 'astro:assets';
import logo from '../../assets/images/brand/logo.png';
import { company } from '../../data/company';
import { legalLinks, mainLinks } from '../../data/navigation';

const currentYear = new Date().getFullYear();
---

<footer class="px-4 pt-16 pb-8 sm:px-6">
	<div class="mx-auto max-w-6xl">
		<div class="flex flex-col items-center gap-8 md:flex-row md:justify-between">
			<a href="/" class="flex w-fit items-center transition-opacity duration-300 ease-smooth hover:opacity-70">
				<Image src={logo} alt={company.brandName} height={64} class="h-7 w-auto" />
			</a>

			{mainLinks.length > 0 && (
				<nav aria-label="Pie de página">
					<ul class="flex flex-wrap justify-center gap-x-7 gap-y-3 text-sm text-secondary md:justify-start">
						{mainLinks.map((link) => (
							<li>
								<a href={link.href} class="transition-colors duration-300 ease-smooth hover:text-primary">{link.label}</a>
							</li>
						))}
					</ul>
				</nav>
			)}
		</div>

		<div class="mt-10 flex flex-col items-center gap-4 border-t border-border/50 pt-6 text-center text-xs text-muted md:flex-row md:justify-between md:text-left">
			<p>© {currentYear} {company.brandName}. Todos los derechos reservados.</p>
			<ul class="flex flex-wrap justify-center gap-x-6 gap-y-2">
				{legalLinks.map((link) => (
					<li>
						<a href={link.href} class="transition-colors duration-300 ease-smooth hover:text-primary">{link.label}</a>
					</li>
				))}
			</ul>
		</div>
	</div>
</footer>
