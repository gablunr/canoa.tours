---
import { ArrowUpRight, CalendarClock, LogOut, MessageCircle, Star, Ticket, UserRound } from '@lucide/astro';
import { bookingPolicy } from '../../../data/booking/booking-policy';
import { company } from '../../../data/site/company';
import { contactLink } from '../../../data/site/navigation';
import Avatar from '../../ui/Avatar.astro';

const tile =
	'group relative flex flex-col bento-glass rounded-2xl p-5 outline-none transition-colors duration-300 ease-smooth hover:bg-white/10 focus-visible:ring-2 focus-visible:ring-accent-on-dark';
const tileTitle = 'text-base leading-tight font-semibold tracking-[-0.02em]';
const tileText = 'mt-1.5 text-[13px] leading-relaxed text-muted-on-dark';
const corner =
	'absolute top-4 right-4 text-white/40 transition duration-300 ease-smooth group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-white';
const pill =
	'inline-flex h-10 items-center gap-2 rounded-full px-4 text-sm font-medium outline-none transition-colors duration-300 ease-smooth focus-visible:ring-2 focus-visible:ring-accent-on-dark';
const compactPill =
	'inline-flex h-9 shrink-0 items-center gap-1.5 rounded-full px-3.5 text-[13px] font-medium whitespace-nowrap outline-none transition-colors duration-300 ease-smooth focus-visible:ring-2 focus-visible:ring-accent-on-dark';
const variant = '[grid-area:1/1] flex flex-col inert:invisible';

const whatsapp = company.whatsapp;
---

<div class="grid grid-cols-12 grid-rows-2 gap-2" data-account-menu>
	<div class="bento-glass col-span-5 row-span-2 grid rounded-2xl p-5">
		<div class={variant} data-account-guest>
			<span class="flex size-10 items-center justify-center rounded-full bg-white/10">
				<UserRound size={18} stroke-width={1.75} aria-hidden="true" />
			</span>
			<span class:list={[tileTitle, 'mt-5 text-xl']}>Entra en tu cuenta</span>
			<span class={tileText}>Te enviamos un enlace a tu email, sin contraseña. Usa el email con el que reservaste.</span>
			<a href="/account/sign-in" class:list={[pill, 'mt-auto w-fit bg-white text-primary hover:bg-white/85']}>
				Entrar
				<ArrowUpRight size={16} aria-hidden="true" />
			</a>
		</div>

		<div class={variant} data-account-member inert>
			<div class="flex items-center gap-3">
				<Avatar class="size-11 text-sm" />
				<div class="flex min-w-0 flex-col">
					<span class:list={[tileTitle, 'text-xl']} data-account-greeting>Hola</span>
					<span class:list={[tileText, 'truncate']} data-account-email></span>
				</div>
			</div>

			<a
				href="/account"
				class="group/next mt-5 flex min-h-32 flex-col justify-center rounded-xl bg-white/10 px-5 py-6 outline-none transition-colors duration-300 ease-smooth hover:bg-white/15 focus-visible:ring-2 focus-visible:ring-accent-on-dark"
				data-account-next
				hidden
			>
				<span class="text-xs text-muted-on-dark">Tu próxima excursión</span>
				<span class="mt-2 text-base leading-snug font-semibold" data-account-next-name></span>
				<span class="mt-1 text-[13px] text-muted-on-dark" data-account-next-date></span>
			</a>
			<p class="mt-5 flex min-h-32 items-center rounded-xl bg-white/10 px-5 py-6 text-[13px] leading-relaxed text-muted-on-dark" data-account-no-next hidden>
				No tienes excursiones próximas.
			</p>

			<div class="mt-auto flex items-center gap-2 pt-5">
				<a href="/account" class:list={[compactPill, 'bg-white text-primary hover:bg-white/85']}>Mis reservas</a>
				<a href="/account/profile" class:list={[compactPill, 'bg-white/10 hover:bg-white/20']}>Perfil</a>
				<form method="post" action="/api/auth/sign-out" class="ml-auto">
					<button
						type="submit"
						class="inline-flex h-9 shrink-0 cursor-pointer items-center gap-1.5 rounded-full px-2 text-[13px] font-medium whitespace-nowrap text-muted-on-dark outline-none transition-colors duration-300 ease-smooth hover:text-white focus-visible:ring-2 focus-visible:ring-accent-on-dark"
					>
						<LogOut size={15} stroke-width={1.75} aria-hidden="true" />
						Salir
					</button>
				</form>
			</div>
		</div>
	</div>

	<a href="/account" data-account-link="ticket" class:list={[tile, 'col-span-4']}>
		<ArrowUpRight size={18} class={corner} aria-hidden="true" />
		<Ticket size={20} class="mb-4 text-accent-on-dark" aria-hidden="true" />
		<span class={tileTitle}>Tu billete</span>
		<span class={tileText}>El código y los detalles de tu reserva, listos para enseñar al guía.</span>
	</a>

	<a href="/account" data-account-link="change-date" class:list={[tile, 'col-span-3']}>
		<ArrowUpRight size={18} class={corner} aria-hidden="true" />
		<CalendarClock size={20} class="mb-4 text-accent-on-dark" aria-hidden="true" />
		<span class={tileTitle}>Cambia la fecha</span>
		<span class={tileText}>Con seguro, hasta {bookingPolicy.maxDateChanges} veces.</span>
	</a>

	<a href="/account" data-account-link="review" class:list={[tile, 'col-span-4']}>
		<ArrowUpRight size={18} class={corner} aria-hidden="true" />
		<Star size={20} class="mb-4 text-accent-on-dark" aria-hidden="true" />
		<span class={tileTitle}>Deja tu opinión</span>
		<span class={tileText}>Después del tour, cuéntanos qué tal fue y ayuda a otros viajeros.</span>
	</a>

	<a
		href={whatsapp?.href ?? contactLink.href}
		target={whatsapp ? '_blank' : undefined}
		rel={whatsapp ? 'noopener' : undefined}
		class="group relative bento-glass col-span-3 flex flex-col rounded-2xl bg-accent p-5 outline-none transition-colors duration-300 ease-smooth hover:bg-accent-strong focus-visible:ring-2 focus-visible:ring-white"
	>
		<ArrowUpRight size={18} class="absolute top-4 right-4 text-white/70 transition duration-300 ease-smooth group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-white" aria-hidden="true" />
		<MessageCircle size={20} class="mb-4" aria-hidden="true" />
		<span class={tileTitle}>¿No encuentras tu reserva?</span>
		<span class="mt-1.5 text-[13px] leading-relaxed text-white/80">{whatsapp ? 'Escríbenos por WhatsApp con tu email.' : 'Escríbenos y te ayudamos.'}</span>
	</a>
</div>
