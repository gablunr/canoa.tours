---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/home/Hero.astro';
import Destinations from '../components/sections/home/Destinations.astro';
import MostBooked from '../components/sections/home/MostBooked.astro';
import BookingBenefits from '../components/sections/home/BookingBenefits.astro';
import Reviews from '../components/sections/home/Reviews.astro';
import HowToBook from '../components/sections/home/HowToBook.astro';
import Faq from '../components/sections/home/Faq.astro';
import BookingCta from '../components/sections/home/BookingCta.astro';
import { faqs } from '../data/booking/faq';
import { faqSchema } from '../lib/seo/structured-data';
import { lowestFromPrice } from '../data/tours/destinations';
import { formatPrice } from '../lib/format';
---

<Layout
	title="Excursiones en Punta Cana con recogida en tu hotel"
	description={`Excursiones desde Punta Cana a Isla Saona, Samaná, Santo Domingo o Coco Bongo, desde ${formatPrice(lowestFromPrice)}. Pagas un depósito online y el resto el día del tour.`}
	pageType="FAQPage"
	mainEntity={faqSchema(faqs)}
	footerOverlapsPhoto
>
	<Hero />
	<Destinations />
	<MostBooked />
	<BookingBenefits />
	<Reviews />
	<HowToBook />
	<Faq
		intro="Cuánto cuestan, si incluyen la recogida, desde dónde salen los barcos, cómo se paga y qué pasa si llueve o necesitas cancelar."
		split
	/>
	<BookingCta />
</Layout>
