---
import Layout from '../layouts/Layout.astro';
import DocumentHeader from '../components/sections/document/DocumentHeader.astro';
import DocumentBody from '../components/sections/document/DocumentBody.astro';
import DocumentClosing from '../components/sections/document/DocumentClosing.astro';
import Button from '../components/ui/Button.astro';
import UnderlineLink from '../components/ui/UnderlineLink.astro';
import { cancellationNoticeLabel } from '../data/booking/booking-policy';
import { documentHref } from '../data/pages/documents';
import { getHelpDocument } from '../data/pages/help';
import { company, whatsappMessageHref } from '../data/site/company';
import { helpLinks } from '../data/site/navigation';

const helpDocument = await getHelpDocument('cancelaciones');
---

<Layout
	title={helpDocument.data.title}
	description={helpDocument.data.description}
	breadcrumbs={[{ name: helpDocument.data.title, path: documentHref(helpDocument) }]}
	modifiedAt={helpDocument.data.updatedAt}
>
	<article data-document>
		<DocumentHeader entry={helpDocument} />
		<DocumentBody entry={helpDocument} relatedTitle="Más ayuda" relatedLinks={helpLinks}>
			<DocumentClosing
				title="Cómo cancelar o cambiar tu fecha"
				text={`Lo haces tú desde el enlace del email de confirmación o desde tu cuenta, al menos ${cancellationNoticeLabel} antes del tour.`}
			>
				<Button href="/account">Ver mis reservas</Button>
				{company.whatsapp && (
					<UnderlineLink tone="accent" href={whatsappMessageHref(company.whatsapp, 'Hola, necesito ayuda con mi reserva')}>
						Pedir ayuda por WhatsApp
					</UnderlineLink>
				)}
			</DocumentClosing>
		</DocumentBody>
	</article>
</Layout>
