---
import type { GetStaticPaths } from 'astro';
import Layout from '../layouts/Layout.astro';
import DocumentHeader from '../components/sections/document/DocumentHeader.astro';
import DocumentBody from '../components/sections/document/DocumentBody.astro';
import DocumentClosing from '../components/sections/document/DocumentClosing.astro';
import UnderlineLink from '../components/ui/UnderlineLink.astro';
import { company } from '../data/site/company';
import { getLegalDocuments, legalHref, type LegalDocument } from '../data/pages/legal';
import { legalLinks } from '../data/site/navigation';

export const getStaticPaths = (async () => {
	const legalDocuments = await getLegalDocuments();

	return legalDocuments.map((legalDocument) => ({
		params: { legal: legalDocument.id },
		props: { legalDocument },
	}));
}) satisfies GetStaticPaths;

interface Props {
	legalDocument: LegalDocument;
}

const { legalDocument } = Astro.props;
---

<Layout
	title={legalDocument.data.title}
	description={legalDocument.data.description}
	breadcrumbs={[{ name: legalDocument.data.title, path: legalHref(legalDocument) }]}
	modifiedAt={legalDocument.data.updatedAt}
>
	<article data-document>
		<DocumentHeader entry={legalDocument} />
		<DocumentBody entry={legalDocument} relatedTitle="Otros documentos" relatedLinks={legalLinks}>
			<DocumentClosing title="¿Tienes dudas sobre este documento?" text="Escríbenos y te respondemos lo antes posible.">
				<UnderlineLink tone="accent" href={`mailto:${company.email}`}>{company.email}</UnderlineLink>
				{company.phone && <UnderlineLink tone="accent" href={company.phone.href}>{company.phone.label}</UnderlineLink>}
			</DocumentClosing>
		</DocumentBody>
	</article>
</Layout>
